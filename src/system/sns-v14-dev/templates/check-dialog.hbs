{{#if senseRequired}}<label>Sentido usado<select name="sense">{{#each senses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if senseBlocked}}<p class="validation-notes">{{senseBlocked}}</p>{{/if}}{{/if}}
<div class="check-modifiers-content">
  {{#if hasConditions}}<label>Teste para se livrar de uma condição<select name="escapeCondition"><option value="" {{#if escapeNoneSelected}}selected{{/if}}>Teste normal</option>{{#each conditionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
  <div class="dialog-row header"><span class="mod">Modificador</span><span class="type">Tipo</span><span class="value"></span><span class="exclude"></span></div>
  <div class="modifier-container">
  {{#each rows}}<div class="dialog-row {{#unless enabled}}off{{/unless}}">
    <span class="mod">{{label}}</span><span class="type"><span class="tag">{{typeLabel}}</span></span><span class="value">{{signed}}</span>
    <span class="exclude"><label class="toggle"><input type="checkbox" data-component="{{id}}" aria-label="Considerar {{label}}" {{#if enabled}}checked{{/if}}><span class="widget" aria-hidden="true"></span></label></span>
  </div>{{/each}}
  </div>
  <hr>
  <div class="add-entry-row">
    <input name="modifierName" placeholder="Modificador" aria-label="Nome do modificador">
    <input name="modifierValue" type="number" step="1" value="1" aria-label="Valor do modificador">
    <select name="modifierType" aria-label="Origem do modificador"><option value="context">Contexto</option><option value="technique">Técnica</option><option value="equipment">Equipamento</option></select>
    <button type="button" data-action="addModifier">+ Adicionar</button>
  </div>
  <hr>
  <div class="check-formula" aria-live="polite"><span>Rolagem</span><output>{{formula}}</output></div>
  <hr>
  <div class="roll-mode-panel">
    <label class="roll-mode">Visibilidade da rolagem<select name="messageMode">{{#each messageModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="show-dialog" title="Segure Shift ao clicar no teste para abrir este diálogo.">Sempre mostrar diálogo<input type="checkbox" name="showDefault" {{#if showDefault}}checked{{/if}}></label>
  </div>
  <hr>
  <button type="submit" class="roll-submit">Rolar ({{total}})</button>
</div>
