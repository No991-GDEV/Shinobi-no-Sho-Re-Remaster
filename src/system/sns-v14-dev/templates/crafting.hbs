<div class="craft-workbench">
 <header class="craft-title"><h2>{{name}}</h2><div><button type="button" data-action="description" aria-label="Consultar fórmula"><i class="fa-solid fa-book-open"></i></button>{{#if isGM}}<button type="button" data-action="configure"><i class="fa-solid fa-gear"></i> Configurar</button>{{/if}}</div></header>
 {{#if waiting}}<p class="craft-notice" role="status">Aguardando o mestre conectado.</p>{{/if}}
 <p class="craft-warning" data-craft-preview-error role="alert" {{#unless error}}hidden{{/unless}}>{{error}}</p>
 {{#unless configured}}<p>Falta definir o preparo. O mestre deve configurar etapas, tempo, custo, materiais e rendimento.</p>{{/unless}}
 {{#if profile}}
 <div class="craft-overview"><span><i class="fa-solid fa-clock"></i> {{#unless isPoison}}<span data-craft-batches>{{#if job}}{{job.batches}}{{else}}{{batches}}{{/if}}</span> × {{/unless}}{{profile.minutes}} min</span><span>{{profile.cost}} Ryo / {{#if isPoison}}dose{{else}}preparo{{/if}}</span>{{#unless isPoison}}<span>{{profile.yield}} unidade(s) / preparo</span>{{/unless}}</div>
 {{#unless job}}{{#if isPoison}}<label>Condições de produção<select name="poisonMode" {{#unless editable}}disabled{{/unless}}>{{#each poisonModes}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if ideal}}<label class="craft-checkbox"><input type="checkbox" name="idealConfirmed"> Disponho de laboratório, materiais e tempo suficiente</label>{{/if}}{{/if}}<label class="craft-batches">{{#if isPoison}}Quantidade de doses{{else}}Quantidade de preparos{{/if}}<input type="number" min="1" max="{{maxBatches}}" step="1" name="batches" value="{{batches}}" {{#unless editable}}disabled{{/unless}}></label><p class="craft-total" data-craft-total {{#unless preview}}hidden{{/unless}}>{{#if preview}}Total: <strong>{{preview.cost}} Ryo</strong> · {{preview.minutes}} min · {{preview.quantity}} unidade(s){{/if}}</p>{{/unless}}
 {{#if ingredients}}<h3>Ingredientes</h3><ul class="craft-materials">{{#each ingredients}}<li><span>{{name}}</span><span><span data-craft-required="{{quantity}}">{{required}}</span> necessários · {{available}} no inventário</span></li>{{/each}}</ul>{{/if}}
 {{#if tools}}<h3>Ferramentas</h3><ul class="craft-materials">{{#each tools}}<li><span>{{name}}</span><span>{{quantity}} · sem consumo</span></li>{{/each}}</ul>{{/if}}
 <h3>Etapas</h3><ol class="craft-steps">{{#each steps}}<li class="{{#if passed}}passed{{/if}} {{#if failed}}failed{{/if}}"><div><strong>{{label}}</strong><small>Dif {{dc}}{{#if result}} · {{result.formula}} = {{result.total}}{{/if}}</small></div>{{#if result}}<span>{{#if passed}}Sucesso{{else}}Falha{{/if}}</span>{{else}}{{#if next}}{{#if @root.editable}}<button type="button" data-action="roll" data-step="{{index}}" {{#if @root.busy}}disabled{{/if}}><i class="fa-solid fa-dice-d8"></i> {{#if @root.ideal}}Simular produção{{else}}Rolar teste{{/if}}</button>{{/if}}{{else}}<span>Aguardando</span>{{/if}}{{/if}}</li>{{else}}<li>Preparo sem teste, conforme configuração da fórmula.</li>{{/each}}</ol>
 {{#if job}}
  {{#if job.working}}<p>Qualidade: <strong>{{job.quality.label}}</strong></p>{{/if}}
  {{#if canFinish}}<label class="craft-checkbox"><input type="checkbox" name="timeConfirmed"> O tempo de preparo transcorreu no jogo</label>{{#if great}}<label>Benefício do Grande Sucesso<select name="benefit"><option value="">Escolher…</option>{{#each benefits}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>{{/if}}<button type="button" class="craft-primary" data-action="finish">Concluir e adicionar ao inventário</button>{{/if}}
  {{#if job.committing}}<p>Preparo parcialmente concluído. Use Retomar conclusão.</p>{{#if editable}}<button type="button" class="craft-primary" data-action="finish">Retomar conclusão</button>{{/if}}{{/if}}
  {{#if job.working}}{{#if editable}}<button type="button" class="craft-interrupt" data-action="cancel">{{#if job.steps.length}}Interromper tentativa{{else}}Cancelar preparo{{/if}}</button>{{/if}}{{/if}}
  {{#if job.done}}<p class="craft-total"><strong>{{job.stateLabel}}</strong>{{#if job.undone}} · materiais e Ryo devolvidos; produto removido{{else}}{{#if job.commit.quality.produces}} · {{job.commit.quality.label}}{{#if job.commit.quantity}} · {{job.commit.quantity}} unidade(s){{/if}}{{/if}}{{/if}}</p><button type="button" data-action="newJob">Novo preparo</button>{{/if}}
  {{#if canUndo}}<button type="button" data-action="undo"><i class="fa-solid fa-rotate-left"></i> Desfazer preparo</button>{{/if}}
 {{else}}<button type="button" class="craft-primary" data-action="start" {{#unless canStart}}disabled{{/unless}}>Iniciar preparo</button>{{/if}}
 <p class="craft-footnote">Materiais e Ryo são descontados ao concluir. Em falhas ou interrupções, aplica-se a perda da fórmula. Ferramentas não são consumidas.</p>
 {{/if}}
 {{#if history}}<details class="craft-history"><summary>Histórico de preparos</summary>{{#each history}}<button type="button" data-action="selectJob" data-job-id="{{id}}"><span>{{date}}</span><strong>{{state}}</strong><small>{{quantity}} unidade(s)</small></button>{{/each}}</details>{{/if}}
</div>
