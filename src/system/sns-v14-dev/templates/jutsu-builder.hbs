<div class="sns-popup-content"><h2>{{#if editing}}Configurar jutsu{{else}}Criar jutsu{{/if}}</h2><label>Nome do jutsu<input name="jutsuName" value="{{name}}" required></label><label>Poder de origem<select name="powerId"><option value="">Selecione um poder da ficha</option>{{#each powers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Efeito aprendido<div class="effect-combobox"><input data-effect-input value="{{#if effects}}{{effectSearch}}{{/if}}" autocomplete="off" placeholder="Digite parte do nome…" aria-label="Pesquisar efeito aprendido"><div id="{{appId}}-effect-options" data-effect-suggestions role="listbox" hidden></div></div></label><div class="jutsu-level-row"><label>Nível usado<input name="usedLevel" type="number" min="{{min}}" max="{{max}}" step="1" value="{{usedLevel}}"></label><label>Forma de uso<select name="variant">{{#each variants}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div><p class="single-effect">Escolha um efeito-base. Combinações exigem uma regra específica.</p>{{#if fields}}<div class="jutsu-parameters">{{#each fields}}<div><strong>{{label}}</strong><span>{{value}}</span><small>{{origin}}{{#if formula}} · {{formula}}{{/if}}</small></div>{{/each}}</div><p>{{notes}}</p><small>Fonte {{source}}</small>{{/if}}{{#if project.problems}}<ul class="validation-notes">{{#each project.problems}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if locked}}<details><summary>Efeitos ainda indisponíveis</summary>{{#each locked}}<p>{{name}} · {{reason}}</p>{{/each}}</details>{{/if}}{{#if overrides}}<section class="jutsu-overrides"><h3>Ajustes do mestre</h3>{{#each overrides}}<p><strong>{{label}}: {{value}}</strong> · {{reason}} <small>Por {{authorLabel}}</small>{{#if @root.isGM}}<button type="button" data-action="removeOverride" data-index="{{index}}" aria-label="Remover exceção {{label}}">×</button>{{/if}}</p>{{/each}}</section>{{/if}}{{#if isGM}}<details class="jutsu-overrides"><summary>Personalização do mestre</summary><p>Ajuste personalizado deste jutsu. Informe o motivo.</p><label>Campo<select name="overrideKey">{{#each overrideFields}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label><label>Valor<input name="overrideValue"></label><label>Justificativa<input name="overrideReason"></label><button type="button" data-action="addOverride">Aplicar exceção ao rascunho</button></details>{{/if}}<footer class="form-footer"><button type="submit" {{#unless canSave}}disabled{{/unless}}>Salvar jutsu</button></footer></div>
