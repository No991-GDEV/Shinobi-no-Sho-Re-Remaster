<div class="sns-effect-editor">
 <header class="sns-effect-editor-header">
  <div class="item-image framed"><img src="{{item.img}}" alt=""></div>
  <div class="sns-effect-header-fields">
   <div class="sns-effect-header-meta">
    <small class="sns-effect-badge {{#if record.active}}is-active{{/if}}">{{#if record.active}}Efeito ativo{{else}}Efeito{{/if}}</small>
    {{#if durationLabel}}<span class="sns-effect-duration">{{durationLabel}}</span>{{/if}}
   </div>
   <input name="name" value="{{item.name}}" aria-label="Nome do efeito">
  </div>
  {{#if canEnd}}<button type="button" class="sns-effect-end" data-action="endEffect"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Encerrar</button>{{/if}}
 </header>
 <div class="sns-effect-editor-body">
 {{#if summary}}<section class="sns-effect-intrinsic"><h3>{{#if record.active}}Benefícios em uso{{else}}Benefícios do efeito{{/if}}</h3><p>{{summary}}</p>{{#if sourceName}}<button type="button" class="sns-effect-source" data-action="openSource"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{sourceName}}</button>{{/if}}{{#if bound}}<small>A ativação e os custos são controlados pela origem.</small>{{/if}}</section>{{/if}}
 <section class="sns-effect-description"><header class="sns-effect-section-heading"><h3>Descrição</h3>{{#if editable}}<button type="button" class="sns-edit-description" data-action="editDescription" aria-label="Editar descrição"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{{/if}}</header><prose-mirror name="system.description" value="{{source.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror></section>
 <label class="sns-effect-notes">Anotações do personagem / mesa<textarea name="system.personalNotes" rows="2" placeholder="Lembretes visíveis para o dono e para o mestre">{{source.personalNotes}}</textarea></label>
 {{#if isGM}}<fieldset><legend>Registro e texto de duração</legend><label>Origem<input name="system.appliedCondition.origin" value="{{record.origin}}"></label><label>Duração no texto<input name="system.appliedCondition.duration" value="{{record.duration}}" placeholder="Até ser encerrado"></label></fieldset>
 {{#if canStatus}}<label class="sns-effect-status"><input type="checkbox" name="system.appliedCondition.active" {{checked record.active}}> Ativo</label>{{/if}}
 {{#if canTime}}{{{durationFields}}}{{else}}<p class="hint">O encerramento segue a técnica de origem.</p>{{/if}}
 <section class="sns-effect-extra-rules"><header class="sns-effect-section-heading"><h3>Alterações adicionais</h3><button type="button" class="sns-effect-add-rule" data-action="addRule"><i class="fa-solid fa-plus" aria-hidden="true"></i> Alteração</button></header><p class="hint">Somadas aos benefícios da origem. Para dureza, vale o maior valor.</p>
 {{#each rules}}<div class="sns-effect-rule" data-effect-rule><select aria-label="Alteração {{index}}" data-rule-target>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><input type="number" min="-100" max="100" step="1" value="{{value}}" aria-label="Valor da alteração {{index}}" data-rule-value><button type="button" class="sns-effect-remove-rule" data-action="removeRule" data-index="{{index}}" aria-label="Remover alteração {{index}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>{{else}}<p class="hint">Sem alterações adicionais.</p>{{/each}}</section>
 {{else}}{{#if sourceName}}<p class="sns-effect-origin-note">Origem: {{sourceName}}</p>{{/if}}{{/if}}
 </div>{{#if editable}}<footer><button type="submit" class="sns-effect-save"><i class="fa-solid fa-check" aria-hidden="true"></i> Salvar efeito</button></footer>{{/if}}
</div>
