<div class="sns-effect-editor">
 <header class="sns-effect-editor-header"><img src="{{item.img}}" alt=""><div><small>{{#if record.active}}Efeito ativo{{else}}Efeito{{/if}}</small><input name="name" value="{{item.name}}" aria-label="Nome do efeito"><span>{{durationLabel}}</span></div>{{#if canEnd}}<button type="button" data-action="endEffect"><i class="fa-solid fa-xmark"></i> Encerrar</button>{{/if}}</header>
 <div class="sns-effect-editor-body">
 {{#if summary}}<section class="sns-effect-intrinsic"><h3>{{#if record.active}}Benefícios em uso{{else}}Benefícios do efeito{{/if}}</h3><p>{{summary}}</p>{{#if sourceName}}<button type="button" data-action="openSource"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{sourceName}}</button>{{/if}}{{#if bound}}<small>A ativação e os custos são controlados pela origem.</small>{{/if}}</section>{{/if}}
 <section><header class="sns-effect-section-heading"><h3>Descrição</h3>{{#if editable}}<button type="button" data-action="editDescription" aria-label="Editar descrição"><i class="fa-solid fa-pen-to-square"></i></button>{{/if}}</header><prose-mirror name="system.description" value="{{source.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror></section>
 <label>Notas<textarea name="system.personalNotes" rows="2">{{source.personalNotes}}</textarea></label>
 {{#if isGM}}<div class="sns-effect-editor-grid"><label>Origem<input name="system.appliedCondition.origin" value="{{record.origin}}"></label><label>Duração no texto<input name="system.appliedCondition.duration" value="{{record.duration}}" placeholder="Até ser encerrado"></label></div>
 {{#if canStatus}}<label class="sns-effect-status"><input type="checkbox" name="system.appliedCondition.active" {{checked record.active}}> Ativo</label>{{/if}}
 {{#if canTime}}{{{durationFields}}}{{else}}<p class="hint">O encerramento segue a técnica de origem.</p>{{/if}}
 <section class="sns-effect-extra-rules"><header class="sns-effect-section-heading"><h3>Alterações adicionais</h3><button type="button" data-action="addRule"><i class="fa-solid fa-plus"></i> Alteração</button></header><p class="hint">Somadas aos benefícios da origem. Para dureza, vale o maior valor.</p>
 {{#each rules}}<div class="sns-effect-rule" data-effect-rule><select aria-label="Alteração {{index}}" data-rule-target>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><input type="number" min="-100" max="100" step="1" value="{{value}}" aria-label="Valor da alteração {{index}}" data-rule-value><button type="button" data-action="removeRule" data-index="{{index}}" aria-label="Remover alteração {{index}}"><i class="fa-solid fa-trash"></i></button></div>{{else}}<p class="hint">Sem alterações adicionais.</p>{{/each}}</section>
 {{else}}{{#if sourceName}}<p>Origem: {{sourceName}}</p>{{/if}}{{/if}}
 </div>{{#if editable}}<footer><button type="submit"><i class="fa-solid fa-check"></i> Salvar efeito</button></footer>{{/if}}
</div>
