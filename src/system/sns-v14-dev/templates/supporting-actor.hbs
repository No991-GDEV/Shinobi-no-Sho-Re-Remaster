{{#*inline "portrait"}}<button type="button" class="profile-image" data-action="documentPortrait" aria-label="Alterar retrato"><img src="{{actor.img}}" alt="{{actor.name}}"></button>{{/inline}}
{{#*inline "actorTags"}}<div class="tags paizo-style"><span class="sns-tag kind-tag">{{profile.label}}</span><div data-trait-picker></div></div>{{/inline}}
{{#*inline "actorNav"}}<nav class="sheet-tabs" aria-label="Abas do ator">{{#if isVehicle}}<span class="panel-title">{{activeLabel}}</span>{{/if}}{{#each tabs}}<button type="button" data-action="documentTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" aria-label="{{label}}" title="{{label}}">{{#if @root.isVehicle}}<i class="fa-solid {{icon}}"></i>{{else}}{{label}}{{/if}}</button>{{/each}}</nav>{{/inline}}
{{#*inline "actorFields"}}{{#each sections}}<section class="section-container"><header class="section-header"><h4>{{label}}</h4></header><div class="section-body field-grid">{{#each fields}}<label class="labeled-field">{{label}}<input name="system.details.{{key}}" value="{{value}}" {{#if numeric}}type="number" step="1" data-nullable placeholder="—"{{/if}} {{#if gmOnly}}{{#unless @root.isGM}}readonly{{/unless}}{{/if}}></label>{{/each}}</div></section>{{/each}}{{/inline}}
{{#*inline "actorEntries"}}{{#if showAppliedStates}}{{> "systems/sns-v14-dev/templates/partials/applied-states.hbs"}}{{> "systems/sns-v14-dev/templates/partials/received-effects.hbs"}}{{else}}{{#each groups}}<section class="section-container entries"><header class="section-header"><h4>{{label}}</h4>{{#if @root.inventory}}<span class="column-label">QTD.</span><span class="column-label compartments-label">COMP.</span>{{/if}}<div class="entry-controls">{{#if @root.editable}}<button type="button" data-action="createEntry" data-category="{{id}}" data-item-type="{{createType}}" aria-label="Criar {{label}}"><i class="fa-solid fa-plus"></i>{{#if @root.isVehicle}}{{#unless @root.inventory}} CRIAR{{/unless}}{{/if}}</button>{{/if}}<button type="button" data-action="browseEntries" data-category="{{id}}" aria-label="Buscar {{label}}"><i class="fa-solid fa-search"></i>{{#if @root.isVehicle}}{{#unless @root.inventory}} BUSCAR{{/unless}}{{/if}}</button></div></header><div class="section-body">{{#each entries}}<article class="ability-entry {{#if @root.features}}compact-feature{{/if}}" data-search-text="{{name}} {{tags}}"><img src="{{img}}" alt=""><div class="ability-content"><button type="button" class="entry-title" data-action="editEntry" data-item-id="{{id}}" aria-label="Consultar {{displayName}}">{{name}}{{#if selectionLabel}}<small class="aptitude-choice-label">{{selectionLabel}}</small>{{/if}}</button>{{#unless @root.features}}<div class="tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</div>{{/unless}}{{#unless @root.inventory}}{{#if weapon}}<div class="npc-weapon-checks">{{#each weaponChecks}}<button type="button" data-action="rollStat" data-stat="{{key}}" data-item-id="{{../id}}" aria-label="{{label}} com {{../name}} {{display}}" {{#unless available}}disabled{{/unless}}{{#unless @root.editable}} disabled{{/unless}}>{{label}} {{display}}{{#if origin}} · {{origin}}{{/if}}</button><button type="button" class="damage-button" data-action="sheetDamage" data-roll="{{key}}" data-item-id="{{../id}}" data-grade="1" aria-label="Dano {{label}} de {{../name}}" title="{{damageFormula}}" {{#unless available}}disabled{{/unless}}{{#unless @root.editable}} disabled{{/unless}}>DANO{{#if hasDamage}} {{damageBase}}{{/if}}</button><button type="button" class="damage-button" data-action="sheetDamage" data-roll="{{key}}" data-item-id="{{../id}}" data-grade="4" aria-label="Crítico {{label}} de {{../name}}" {{#unless available}}disabled{{/unless}}{{#unless @root.editable}} disabled{{/unless}}>CRÍTICO</button>{{else}}<button type="button" data-action="editEntry" data-item-id="{{id}}">Definir formas de ataque</button>{{/each}}{{#unless temporaryFists}}{{#if @root.editable}}<button type="button" class="weapon-usage" data-action="toggleEquipped" data-item-id="{{id}}">{{#if equipped}}Em uso · guardar{{else}}Marcar em uso{{/if}}</button>{{/if}}{{/unless}}</div>{{#if temporaryFists}}<p class="activation-facts">Dano conforme os efeitos ativos de Energizar.</p>{{else}}<p class="activation-facts">Quantidade {{quantity}}{{#if details.damage}} · Dano da arma {{details.damage}}{{/if}}{{#if details.range}} · {{details.range}}{{/if}}</p>{{/if}}{{else}}{{#if canRoll}}{{#if @root.editable}}<button type="button" class="attack-button" data-action="rollStat" data-item-id="{{id}}">TESTE {{signedPrecision}}</button>{{/if}}{{/if}}<p class="activation-facts">{{details.action}}{{#if details.range}} · {{details.range}}{{/if}}{{#if details.chakraCost}} · Chakra {{details.chakraCost}}{{/if}}{{#if details.damage}} · DB {{details.damage}}{{/if}}</p>{{/if}}{{/unless}}</div>{{#if @root.inventory}}<span class="item-quantity">{{quantity}}</span><span class="item-compartments">{{compartments}}</span>{{/if}}{{#unless temporaryFists}}{{#if @root.editable}}<button type="button" class="inline-control" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}{{/unless}}</article>{{/each}}</div></section>{{/each}}{{/if}}{{/inline}}
{{#*inline "inventoryPanel"}}<div class="inventory-panel"><header class="inventory-summary"><i class="fa-solid fa-coins"></i><strong>{{#if isLoot}}Saldo{{else}}{{#if isParty}}Saldo do depósito{{else}}Inventário{{/if}}{{/if}}</strong>{{#if hasFunds}}<input name="system.details.funds" type="number" min="0" step="1" data-nullable value="{{source.details.funds}}" placeholder="—" aria-label="Saldo em Ryo" {{#unless isGM}}readonly{{/unless}}><span>Ryo</span>{{else}}<span>{{inventorySummary.count}} itens</span>{{/if}}</header><label class="inventory-search"><i class="fa-solid fa-search"></i><input type="search" data-inventory-search placeholder="Buscar no inventário" aria-label="Buscar no inventário"></label><div class="inventory-entries">{{> actorEntries}}</div><footer class="inventory-total"><i class="fa-solid fa-box"></i> Compartimentos: {{inventorySummary.compartments}}</footer></div>{{/inline}}
{{#*inline "publication"}}<fieldset class="publication"><legend>Publicação</legend><label>Livro / referência<input name="system.source.id" value="{{source.source.id}}"></label><div class="publication-row"><label>Edição<input name="system.source.edition" value="{{source.source.edition}}"></label><label>Páginas<input name="system.source.pages" value="{{source.source.pages}}"></label></div></fieldset>{{/inline}}
{{#*inline "actorNotes"}}<section class="notes-section"><h4>Descrição</h4><prose-mirror name="system.description" value="{{source.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror></section>{{> publication}}{{/inline}}
{{#*inline "memberCards"}}<div class="member-list">{{#each members}}<article class="member-card"><div class="member-portrait"><img src="{{img}}" alt=""><span><i class="fa-solid fa-heart"></i> {{vitality}} / {{vitalityMax}}</span></div><div class="member-content"><div class="member-name"><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button>{{#if @root.editable}}<button type="button" data-action="removeMember" data-uuid="{{uuid}}" aria-label="Desvincular {{name}}">×</button>{{/if}}</div><div class="member-stats"><span>NC <strong>{{nc}}</strong></span><span>Esquiva <strong>{{dodge}}</strong></span><span>Chakra <strong>{{chakra}} / {{chakraMax}}</strong></span><span>Andar <strong>{{movement}} m</strong></span></div><p>{{senses}}</p></div></article>{{else}}<p class="empty-state">Vincule os personagens que fazem parte desta equipe.</p>{{/each}}</div>{{/inline}}
{{#*inline "npcSidebar"}}<aside class="npc-sidebar">{{> portrait}}<section class="subsection defense"><header title="Defesa fixa: 9 + precisão de esquiva, com os modificadores aplicáveis."><label><i class="fa-solid fa-shield-halved"></i> {{defenseLabel}}</label><strong>{{fixedDodge}}</strong></header></section>{{#each resources}}<section class="subsection resource"><header><label>{{#if (snsIsTab key "vitality")}}<i class="fa-solid fa-heart"></i>{{else}}<i class="fa-solid fa-circle-dot"></i>{{/if}} {{label}}</label><div class="hit-points"><input name="system.resources.{{key}}.value" aria-label="{{label}} atual" type="number" step="1" data-nullable value="{{value}}" placeholder="—"><span>/</span>{{#if maxAdjusted}}<strong title="Máximo base {{inputMax}}; efeito da característica de transplante">{{effectiveMax}}</strong>{{#if @root.editable}}<button type="button" data-action="editChakraBase" aria-label="Editar máximo base de chakra"><i class="fa-solid fa-pen-to-square"></i></button>{{/if}}{{else}}<input name="system.resources.{{key}}.{{maxField}}" aria-label="{{label}} máximo" type="number" step="1" min="0" data-nullable value="{{inputMax}}" placeholder="—">{{/if}}</div></header></section>{{/each}}<section class="subsection"><header><label><i class="fa-solid fa-dice-d8"></i> Iniciativa</label><button type="button" data-action="rollStat" data-stat="initiative" aria-label="Rolar Iniciativa"><i class="fa-solid fa-dice-d8"></i></button><input name="system.stats.initiative" aria-label="Iniciativa" type="number" step="1" data-nullable value="{{source.stats.initiative}}" placeholder="—"></header></section>{{#each defenseGroups}}<section class="subsection sns-actor-defense"><header><span>{{label}}</span>{{#if @root.editable}}<button type="button" data-action="editDefenses" data-category="{{category}}" aria-label="Editar {{label}}" title="Editar {{label}}"><i class="fa-solid fa-pen-to-square"></i></button>{{/if}}</header><ul class="sns-defense-list">{{#each entries}}<li title="{{note}}"><span>{{name}}{{#if hasValue}} <strong>{{displayValue}}</strong>{{/if}}</span>{{#if exceptions}}<small>Exceto {{exceptions}}</small>{{/if}}{{#if note}}<small>{{note}}</small>{{/if}}</li>{{else}}<li class="empty-state">—</li>{{/each}}</ul></section>{{/each}}<section class="subsection"><header>Deslocamento</header><label class="sidebar-speed"><input name="system.stats.movement" aria-label="Deslocamento" type="number" step="1" data-nullable value="{{source.stats.movement}}" placeholder="—">m</label>{{#if movementModified}}<small class="sns-derived-speed">Atual <strong>{{effectiveMovement}} m</strong></small>{{/if}}</section></aside>{{/inline}}
<div class="actor-layout family-{{type}} {{#if inventory}}show-inventory{{/if}}">
{{#if profile.combat}}
 {{> npcSidebar}}
 <div class="npc-body"><header class="npc-header"><div class="name-line"><input name="name" value="{{actor.name}}" aria-label="Nome"><span>NC</span><input name="system.nc" type="number" min="0" step="1" data-nullable value="{{source.nc}}" placeholder="—" aria-label="NC"></div>{{> actorTags}}<div class="identity-line"><input name="system.details.rank" value="{{source.details.rank}}" placeholder="Rank" aria-label="Rank"><input name="system.details.village" value="{{source.details.village}}" placeholder="Vila / facção" aria-label="Vila / facção"><input name="system.details.defense" value="{{source.details.defense}}" placeholder="Defesa publicada" aria-label="Defesa publicada"></div>{{#if editable}}<button type="button" class="npc-size-control" data-action="editSize" aria-label="Alterar tamanho" title="Alterar tamanho"><i class="fa-solid fa-ruler-vertical"></i> Tamanho</button>{{/if}}<input class="npc-blurb" name="system.details.role" value="{{source.details.role}}" placeholder="Papel / comportamento" aria-label="Papel / comportamento"></header>{{> "systems/sns-v14-dev/templates/partials/kuchiyose-link.hbs"}}{{> actorNav}}
 <main class="actor-panels document-panel">{{#if inventory}}{{> inventoryPanel}}{{else}}{{#if details}}<section class="section-container combat-ratings"><header class="section-header"><h4>Habilidades de combate</h4>{{#if isGM}}{{#if editable}}<button type="button" data-action="editPrerequisites" aria-label="Editar valores para requisitos">Requisitos</button>{{/if}}{{/if}}</header><div class="section-body">{{#each stats}}{{#unless (snsIsTab key "initiative")}}{{#unless (snsIsTab key "movement")}}<label title="{{#if (snsIsTab key "esq")}}Precisão do teste; defesa fixa = 9 + precisão, com os modificadores aplicáveis.{{/if}}">{{#if (snsIsTab key "esq")}}Precisão de esquiva{{else}}{{label}}{{/if}}<div><input name="system.stats.{{key}}" value="{{value}}" type="number" step="1" data-nullable placeholder="—">{{#if conditionAdjustment}}<small title="Precisão com condições">Efetivo {{effectiveValue}}</small>{{/if}}{{#if rollable}}<button type="button" data-action="rollStat" data-stat="{{key}}" aria-label="Rolar {{label}}"><i class="fa-solid fa-dice-d8"></i></button>{{/if}}</div></label>{{/unless}}{{/unless}}{{/each}}</div></section><div class="npc-main-grid"><section class="section-container"><header class="section-header"><h4>Atributos</h4></header><div class="section-body npc-attributes">{{#each attributes}}<label title="{{label}}">{{abbr}}<input name="system.attributes.{{key}}" type="number" step="1" data-nullable value="{{value}}" placeholder="—"></label>{{/each}}</div></section><section class="section-container"><header class="section-header"><h4>Sentidos</h4></header><div class="section-body"><input name="system.details.senses" value="{{source.details.senses}}" aria-label="Sentidos" placeholder="Sentidos especiais"></div></section></div><section class="section-container"><header class="section-header"><h4>Idiomas</h4></header><div class="section-body"><input name="system.details.languages" value="{{source.details.languages}}" aria-label="Idiomas"></div></section><section class="section-container"><header class="section-header"><h4>Perícias</h4>{{#if editable}}<button type="button" data-action="editRecordedSkills" aria-label="Editar perícias"><i class="fa-solid fa-pen-to-square"></i></button>{{/if}}</header><div class="section-body npc-recorded-skills">{{#each recordedSkills}}{{#if untrained}}<span class="npc-skill untrained" title="Sem treinamento">{{name}} <strong>X</strong></span>{{else}}<button type="button" class="npc-skill" data-action="rollRecordedSkill" data-skill="{{key}}" aria-label="Rolar {{name}} {{display}}" {{#unless @root.editable}}disabled{{/unless}}><span>{{name}}</span> <strong>{{display}}</strong></button>{{/if}}{{else}}<p class="empty-state">Adicione perícias pelo lápis.</p>{{/each}}</div><details class="legacy-skill-note"><summary>Anotações de perícias</summary><p>Use o lápis para editar a lista de perícias.</p><textarea name="system.details.skills" aria-label="Anotação livre de perícias" rows="2">{{source.details.skills}}</textarea></details></section>{{#if isCompanion}}{{> actorFields}}{{/if}}{{> actorEntries}}{{> "systems/sns-v14-dev/templates/partials/transformations.hbs"}}
{{> "systems/sns-v14-dev/templates/partials/active-aptitudes.hbs"}}{{else}}{{#if notes}}{{> actorNotes}}{{else}}{{#if jutsus}}<div class="sns-sheet shared-jutsus">{{> "systems/sns-v14-dev/templates/tabs/jutsus.hbs"}}</div>{{else}}{{> actorEntries}}{{/if}}{{/if}}{{/if}}{{/if}}</main></div>
{{else}}{{#if isHazard}}
 <header class="banner-header hazard-header">{{> portrait}}<div class="banner-title"><input name="name" value="{{actor.name}}" aria-label="Nome">{{> actorTags}}</div><strong class="banner-type">Perigo</strong></header><aside class="hazard-sidebar"><section class="subsection"><header>Defesas</header><input name="system.details.resistance" value="{{source.details.resistance}}" aria-label="Resistência / integridade"></section><section class="subsection"><header>Imunidades</header><input name="system.details.immunities" value="{{source.details.immunities}}" aria-label="Imunidades"></section><section class="subsection"><header>Fraquezas</header><input name="system.details.weaknesses" value="{{source.details.weaknesses}}" aria-label="Fraquezas"></section><section class="subsection"><header>Resistências</header><input name="system.details.resistances" value="{{source.details.resistances}}" aria-label="Resistências"></section></aside><main class="actor-panels hazard-body">{{> actorFields}}{{> actorEntries}}{{> actorNotes}}</main>
{{else}}{{#if isParty}}
 {{> "systems/sns-v14-dev/templates/partials/party.hbs"}}
{{else}}{{#if isLoot}}
 <aside class="loot-sidebar">{{> portrait}}<button type="button" class="gold-button" data-action="documentTab" data-tab="details"><i class="fa-solid fa-sliders"></i> Configurar depósito</button><button type="button" class="gold-button" data-action="browseEntries" data-category="equipment"><i class="fa-solid fa-search"></i> Buscar equipamentos</button><h4>Proprietário</h4><p>{{source.details.owner}}</p><h4>Localização</h4><p>{{source.details.location}}</p></aside><div class="auxiliary-body"><header class="loot-header"><div class="name-line"><input name="name" value="{{actor.name}}" aria-label="Nome"></div>{{> actorTags}}</header>{{> actorNav}}<main class="actor-panels">{{#if inventory}}{{> inventoryPanel}}{{else}}{{#if notes}}{{> actorNotes}}{{else}}{{> actorFields}}{{/if}}{{/if}}</main></div>
{{else}}{{#if isVehicle}}
 <aside class="vehicle-sidebar"><div class="vehicle-sidebar-content"><h4>Vitalidade</h4><div class="vehicle-resources"><label>Atual<input name="system.resources.vitality.value" value="{{source.resources.vitality.value}}" type="number" step="1" data-nullable placeholder="—" aria-label="Vitalidade atual"></label><label>Máxima<input name="system.resources.vitality.max" value="{{source.resources.vitality.max}}" type="number" min="0" step="1" data-nullable placeholder="—" aria-label="Vitalidade máxima"></label></div><h4>Estrutura</h4><div class="vehicle-shields"><label class="structure-shield"><input name="system.details.integrity" value="{{source.details.integrity}}" aria-label="Integridade" placeholder="—"><span>Integridade</span></label><label class="structure-shield"><input name="system.details.resistance" value="{{source.details.resistance}}" aria-label="Resistência" placeholder="—"><span>Resistência</span></label></div><h4>Imunidades</h4><input name="system.details.immunities" value="{{source.details.immunities}}" aria-label="Imunidades"><h4>Fraquezas</h4><input name="system.details.weaknesses" value="{{source.details.weaknesses}}" aria-label="Fraquezas"><h4>Resistências adicionais</h4><input name="system.details.resistances" value="{{source.details.resistances}}" aria-label="Resistências adicionais"></div></aside><div class="auxiliary-body"><header class="vehicle-header"><div class="vehicle-title"><input name="name" value="{{actor.name}}" aria-label="Nome">{{> actorTags}}</div><label class="nc-shield">NC<input name="system.nc" value="{{source.nc}}" type="number" min="0" step="1" data-nullable placeholder="—" aria-label="NC"></label></header>{{> actorNav}}<main class="actor-panels">{{#if inventory}}{{> inventoryPanel}}{{else}}{{#if details}}<div class="vehicle-portrait">{{> portrait}}</div>{{> actorFields}}{{else}}{{#if notes}}{{> actorNotes}}{{else}}{{> actorEntries}}{{/if}}{{/if}}{{/if}}</main></div>
{{else}}
 <div class="auxiliary-body"><header class="auxiliary-header">{{> portrait}}<div class="auxiliary-title"><div class="name-line"><input name="name" value="{{actor.name}}" aria-label="Nome"></div>{{> actorTags}}</div></header>{{> actorNav}}<main class="actor-panels">{{#if inventory}}{{> inventoryPanel}}{{else}}{{#if details}}{{> actorFields}}{{else}}{{#if notes}}{{> actorNotes}}{{else}}{{> actorEntries}}{{/if}}{{/if}}{{/if}}</main></div>
{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
</div>

