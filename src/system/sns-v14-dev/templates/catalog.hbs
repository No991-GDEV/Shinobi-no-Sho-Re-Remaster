{{#if libraryError}}<p class="sns-library-error" role="alert">Não foi possível carregar a biblioteca. <button type="button" data-action="retry">Tentar novamente</button></p>{{/if}}
<div class="catalog-shell">
<nav class="catalog-tabs" role="tablist" aria-label="Categorias do compêndio">{{#each tabs}}<button type="button" role="tab" data-action="switchCategory" data-category="{{id}}" aria-selected="{{#if active}}true{{else}}false{{/if}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
<div class="catalog-layout">
<aside class="catalog-filters" aria-label="Filtros do compêndio">
<section class="catalog-search-box"><label class="sr-only" for="{{appId}}-query">Pesquisar catálogo SNS</label><input id="{{appId}}-query" type="search" data-filter="query" value="{{filters.query}}" aria-label="Pesquisar catálogo SNS" placeholder="Pesquisar…"><label class="catalog-check"><input type="checkbox" data-filter="allCategories" {{#if filters.allCategories}}checked{{/if}}>Buscar em todas as categorias</label><div class="catalog-sort"><label for="{{appId}}-sort">Ordenar por</label><select id="{{appId}}-sort" data-filter="sort"><option value="level" {{#if sortLevel}}selected{{/if}}>{{ratingLabel}}</option><option value="name" {{#if sortName}}selected{{/if}}>Nome</option></select><button type="button" data-action="reverseSort" aria-label="Inverter ordem" title="{{#if descending}}Decrescente{{else}}Crescente{{/if}}"><i class="fa-solid {{#if descending}}fa-arrow-down-wide-short{{else}}fa-arrow-down-short-wide{{/if}}"></i></button></div><button type="button" class="catalog-clear" data-action="clearFilters">Limpar todos os filtros</button></section>
{{#if linked}}<label class="catalog-check catalog-only-met"><input type="checkbox" data-filter="onlyMet" {{#if onlyMetChecked}}checked{{/if}}>Somente requisitos atendidos</label>{{else}}<p class="catalog-only-met-disabled" title="Abra o catálogo a partir da ficha do personagem para filtrar pelos requisitos.">Filtro por requisitos: vincule uma ficha</p>{{/if}}
{{#if hiddenUnknownText}}<p class="catalog-only-met-hidden">{{hiddenUnknownText}}</p>{{/if}}
<fieldset class="catalog-trait-filter"><legend>Traits</legend><div class="catalog-trait-field" data-trait-field><div class="catalog-trait-chips">{{#each traitChips}}<span class="catalog-trait-chip {{#if excluded}}excluded{{/if}}" title="{{title}}"><span>{{label}}</span><button type="button" data-action="toggleTrait" data-trait-id="{{id}}" aria-label="{{#if excluded}}Incluir{{else}}Excluir{{/if}} {{label}}" title="{{#if excluded}}Incluir nas correspondências{{else}}Excluir das correspondências{{/if}}"><i class="fa-solid fa-ban" aria-hidden="true"></i></button><button type="button" data-action="removeTrait" data-trait-id="{{id}}" aria-label="Remover filtro {{label}}">×</button></span>{{/each}}</div><div class="catalog-trait-input-line"><input type="text" data-catalog-trait-input placeholder="Pesquisar ou escolher…" aria-label="Pesquisar traits" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="{{appId}}-trait-list" autocomplete="off"><button type="button" data-trait-toggle aria-label="Abrir lista de traits" aria-expanded="false"><i class="fa-solid fa-chevron-down"></i></button><button type="button" data-action="clearTraits" aria-label="Limpar traits">×</button></div></div><div id="{{appId}}-trait-list" class="catalog-trait-popover" data-catalog-trait-list popover="manual" role="listbox" aria-label="Lista de traits"></div><div class="catalog-trait-match" role="radiogroup" aria-label="Combinar traits"><label><input type="radio" name="{{appId}}-match" data-filter="match" value="all" {{#if all}}checked{{/if}}>Todas</label><label><input type="radio" name="{{appId}}-match" data-filter="match" value="any" {{#if any}}checked{{/if}}>Qualquer uma</label></div></fieldset>
<details class="catalog-filter-group" data-filter-panel="types" {{#if openTypes}}open{{/if}}><summary>Tipos</summary><div><label class="sr-only" for="{{appId}}-type">Tipo de entrada</label><select id="{{appId}}-type" data-filter="type" aria-label="Tipo de entrada"><option value="">Todos os tipos</option>{{#each typeGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</optgroup>{{/each}}</select></div></details>
{{#if showSizes}}<details class="catalog-filter-group" data-filter-panel="sizes" {{#if openSizes}}open{{/if}}><summary>Tamanhos</summary><div>{{#each sizes}}<label class="catalog-check"><input type="checkbox" data-filter="sizes" value="{{id}}" {{#if selected}}checked{{/if}}>{{label}}</label>{{/each}}</div></details>{{/if}}
<details class="catalog-filter-group" data-filter-panel="sources" {{#if openSources}}open{{/if}}><summary>Fontes</summary><div>{{#each sources}}<label class="catalog-check"><input type="checkbox" data-filter="sources" value="{{id}}" {{#if selected}}checked{{/if}}>{{name}}</label>{{else}}<p>Nenhuma fonte publicada nesta categoria.</p>{{/each}}</div></details>
<details class="catalog-filter-group" data-filter-panel="levels" {{#if openLevels}}open{{/if}}><summary>{{levelsLabel}}</summary><div class="level-filters"><label>Mínimo<input type="number" min="0" data-filter="min" value="{{filters.min}}" aria-label="Nível mínimo"></label><label>Máximo<input type="number" min="0" data-filter="max" value="{{filters.max}}" aria-label="Nível máximo"></label></div>{{#if showRanks}}<div class="rank-filters" aria-label="Ranks dos jutsus">{{#each rankChoices}}<label class="catalog-check"><input type="checkbox" data-filter="ranks" value="{{id}}" {{#if selected}}checked{{/if}}>{{label}}</label>{{/each}}</div>{{/if}}</details>
<label class="catalog-check catalog-world"><input type="checkbox" data-filter="includeWorld" {{#if filters.includeWorld}}checked{{/if}}>Incluir itens do mundo</label>
</aside>
<main class="catalog-results" aria-label="Resultados do compêndio"><header class="catalog-results-header{{#if showPrices}} catalog-header-prices{{/if}}">{{#if showPrices}}<span>{{activeCategory}} · {{count}} / {{total}}</span><span>{{ratingLabel}}</span><span>{{priceLabel}}</span>{{else}}<span>{{activeCategory}} · {{count}} / {{total}}</span><span>{{ratingLabel}}</span>{{/if}}</header>
{{#each rows}}<article class="catalog-row{{#if @root.showPrices}} catalog-row-prices{{/if}}" {{#if uuid}}draggable="true" data-drag-uuid="{{uuid}}" data-drag-type="{{documentName}}"{{/if}}><img src="{{img}}" alt="" loading="lazy"><div><button type="button" data-action="open" data-id="{{id}}">{{name}}</button><small title="{{source}} · {{origin}}">{{shortSource}}</small>{{#if requirementMessage}}<small class="catalog-requirements" title="{{requirementTitle}}">{{requirementMessage}}</small>{{/if}}</div><span class="catalog-kind">{{typeLabel}}</span><span class="catalog-level" title="{{levelTitle}}">{{levelDisplay}}</span>{{#if @root.showPrices}}<span class="catalog-price" title="{{price.title}}">{{price.display}}</span>{{/if}}{{#if canAdd}}<button type="button" data-action="add" data-id="{{id}}" aria-label="Adicionar {{name}} à ficha" class="catalog-add"><i class="fa-solid fa-plus"></i></button>{{else}}{{#if addBlocked}}<button type="button" class="catalog-add" disabled aria-label="Não é possível adicionar {{name}}" title="{{requirementTitle}}"><i class="fa-solid fa-lock" aria-hidden="true"></i></button>{{else}}<span></span>{{/if}}{{/if}}</article>{{else}}<p class="catalog-empty">{{emptyText}}</p>{{/each}}
{{#if hasMore}}<footer class="sns-catalog-more"><span>Mostrando {{renderedCount}} de {{count}}</span><button type="button" data-action="loadMore">Mostrar mais · {{remainingCount}} restantes</button></footer>{{/if}}
</main></div>
</div>
