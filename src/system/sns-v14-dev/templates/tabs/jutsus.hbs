{{#*inline "jutsuRow"}}<article class="sns-jutsu-row"><button type="button" class="entry-name" data-action="{{#if npcTechnique}}useJutsu{{else}}editEntry{{/if}}" data-item-id="{{id}}"><img src="{{img}}" alt=""><span>{{name}}<small>{{details.action}}</small></span></button><span>{{#if details.chakraCost}}{{details.chakraCost}}{{else}}—{{/if}}</span><span>{{#if details.range}}{{details.range}}{{else}}—{{/if}}</span><div class="jutsu-controls">{{#if canUse}}{{#if @root.npcCanCast}}<button type="button" class="jutsu-use" data-action="useJutsu" data-item-id="{{id}}" aria-label="Usar {{name}}"><i class="fa-solid fa-dice-d8"></i> Usar</button>{{else}}{{#if @root.editable}}<button type="button" class="jutsu-use" data-action="useJutsu" data-item-id="{{id}}" aria-label="Usar {{name}}"><i class="fa-solid {{#if noRoll}}fa-hand-sparkles{{else}}fa-dice-d8{{/if}}"></i></button>{{/if}}{{/if}}{{/if}}{{#if consultOnly}}<button type="button" class="jutsu-consult" data-action="editEntry" data-item-id="{{id}}" title="Abrir descrição">Consultar</button>{{/if}}<button type="button" class="{{#if npcTechnique}}jutsu-consult{{/if}}" data-action="editEntry" data-item-id="{{id}}" aria-label="{{#if npcTechnique}}Consultar{{else}}Editar{{/if}} {{name}}"><i class="fa-solid {{#if npcTechnique}}fa-book-open{{else}}fa-pen-to-square{{/if}}"></i></button>{{#if @root.editable}}<button type="button" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{displayName}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div></article>{{/inline}}
<section class="tab-pane jutsus-pane" role="tabpanel" aria-label="Jutsus" {{#unless (snsIsTab activeTab "jutsus")}}hidden{{/unless}}>
{{#if powers}}{{#if d.budgets.powers}}<div class="sns-power-budget">{{> "systems/sns-v14-dev/templates/partials/budget-context.hbs" budget=d.budgets.powers label="Pontos de poder"}}{{#unless investment.complete}}<button type="button" class="sns-budget-review" data-action="showEvolution">Conferir aquisições</button>{{/unless}}</div>{{/if}}{{/if}}
{{#if powers}}{{#if specialResources}}<section class="special-resources"><header class="pf-section"><h2>Recursos especiais</h2></header>{{#each specialResources}}<article class="special-resource-row"><div><strong>{{label}}</strong><small>Por <button type="button" data-action="editEntry" data-item-id="{{sourceId}}">{{sourceName}}</button></small>{{#each problems}}<small class="resource-issue">{{this}}</small>{{/each}}</div><div class="resource-meter {{#unless known}}is-unknown{{/unless}}" {{#if known}}role="meter" aria-valuemin="0" aria-valuemax="{{max}}" aria-valuenow="{{value}}"{{/if}} aria-label="{{label}}: atual {{valueLabel}}, máximo {{maxLabel}}"><div class="resource-meter-fill" style="width:{{percent}}%"></div><span>{{valueLabel}} <small>/ {{maxLabel}}</small></span></div>{{#if @root.editable}}<button type="button" data-action="editSpecialResource" data-resource-id="{{id}}" aria-label="Ajustar {{label}}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{{/if}}</article>{{/each}}</section>{{/if}}{{/if}}
{{#if legado}}<section class="sns-legado-panel"><header><strong><i class="fa-solid fa-eye"></i> Legado do Ódio</strong>{{#if editable}}<button type="button" data-action="configureLegado"><i class="fa-solid fa-sliders"></i> Olhos e escolhas</button>{{/if}}</header><p>{{legado.pair}}</p>{{#if legado.vision}}<small>Visão: {{legado.vision.value}} / {{legado.vision.max}} · cegueira {{legado.vision.blindness}}{{#if legado.vision.locked}} · Em recuperação{{/if}}</small>{{#if editable}}<button type="button" data-action="legadoControl" data-legado-op="rest-vision"><i class="fa-solid fa-bed"></i> Descanso Sharingan</button>{{/if}}{{/if}}{{#if legado.vision.locked}}{{#if isGM}}<button type="button" data-action="legadoControl" data-legado-op="unlock-eye">Liberar olho após recuperação</button>{{/if}}{{/if}}{{#if legado.susanoo}}<div class="sns-legado-absorption"><span>Susano’o {{legado.susanoo.stage}} · {{legado.susanoo.name}}</span><meter min="0" max="{{legado.susanoo.max}}" value="{{legado.susanoo.value}}"></meter><strong>{{legado.susanoo.value}} / {{legado.susanoo.max}}</strong></div>{{/if}}{{#if legado.copies}}<details><summary>Mímica · {{legado.mimicUsed}} / {{legado.mimicMax}} PM alocados</summary>{{#each legado.copies}}<p>{{label}}</p>{{/each}}</details>{{/if}}{{#each legado.active}}<div class="sns-legado-active"><span>{{label}}</span>{{#if @root.editable}}<button type="button" data-action="legadoControl" data-legado-op="end-active" data-legado-key="{{key}}">Encerrar</button>{{/if}}</div>{{/each}}</section>{{/if}}
<nav class="sub-nav" aria-label="Grupos de jutsus"><button type="button" data-action="chooseContext" data-group="jutsus" data-context="powers" class="{{#if powers}}active{{/if}}">Poderes e jutsus</button><button type="button" data-action="chooseContext" data-group="jutsus" data-context="techniques" class="{{#if techniques}}active{{/if}}">Técnicas avulsas</button><button type="button" data-action="chooseContext" data-group="jutsus" data-context="effects" class="{{#if effects}}active{{/if}}">Efeitos ativos</button></nav>
{{#if powers}}{{#each powerGroups}}<section class="power-block"><header class="power-heading"><i class="fa-solid fa-bars"></i><h3><button type="button" class="power-title" data-action="editEntry" data-item-id="{{id}}" aria-label="Consultar {{displayName}}">{{name}}</button></h3>{{#if @root.editable}}<button type="button" data-action="configurePower" data-item-id="{{id}}" aria-label="Configurar {{displayName}}"><i class="fa-solid fa-pen-to-square"></i></button><button type="button" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{displayName}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</header><div class="power-summary"><strong>Nível {{level}}</strong><span>{{originLabel}}</span>{{#if selectionLabel}}<span class="power-selection">{{selectionLabel}}</span>{{/if}}<span>{{details.nature}}</span><button type="button" data-action="manageJutsus" data-item-id="{{id}}"><i class="fa-solid fa-book-open"></i> Gerenciar jutsus</button></div>{{#if bookGrantLabel}}<div class="power-form">{{bookGrantLabel}}</div>{{/if}}<div class="power-form">{{formLabel}}{{#if guided}} · <button type="button" data-action="learnEffects" data-item-id="{{id}}">Efeitos aprendidos</button>{{#if @root.editable}} <button type="button" data-action="buildJutsu" data-power-id="{{id}}">Criar jutsu</button>{{/if}}{{/if}}</div><header class="jutsu-columns"><span>Jutsus vinculados</span><span>Chakra</span><span>Alcance</span><div class="controls">{{#if @root.editable}}<button type="button" data-action="createEntry" data-category="techniques" data-item-type="jutsu" data-power-id="{{id}}" aria-label="Adicionar jutsu a {{name}}"><i class="fa-solid fa-plus"></i></button>{{/if}}<button type="button" data-action="browseEntries" data-category="techniques" data-power-id="{{id}}" aria-label="Buscar jutsu para {{name}}"><i class="fa-solid fa-search"></i></button></div></header>{{#each techniques}}{{> jutsuRow}}{{else}}<p class="empty-power">Nenhum jutsu. Adicione pelo + ou por Gerenciar jutsus.</p>{{/each}}</section>{{/each}}{{#each aptitudePowerGroups}}<section class="power-block aptitude-power"><header class="power-heading"><i class="fa-solid fa-bolt"></i><h3><button type="button" class="power-title" data-action="editEntry" data-item-id="{{id}}">{{name}}</button></h3></header><div class="power-summary"><span>Progressão adquirida</span>{{#each stages}}<button type="button" data-action="editEntry" data-item-id="{{id}}">{{stageLabel}}{{#if details.powerCost}} · {{details.powerCost}} PP{{/if}}</button>{{/each}}</div><header class="jutsu-columns"><span>Jutsu</span><span>Chakra</span><span>Alcance</span>{{#if @root.editable}}<button type="button" data-action="createGrantedJutsu" data-item-id="{{id}}" aria-label="Adicionar jutsu de {{name}}"><i class="fa-solid fa-plus"></i></button>{{/if}}</header>{{#each techniques}}{{> jutsuRow}}{{else}}<p class="empty-power">Adicione o jutsu concedido pela progressão.</p>{{/each}}</section>{{/each}}{{#if grantGroups}}<section class="granted-jutsus"><header class="pf-section"><h2>Concedidos por aptidões</h2></header>{{#each grantGroups}}<section class="power-block granted-source"><header class="power-heading"><i class="fa-solid fa-gift" aria-hidden="true"></i><h3>{{#if available}}<button type="button" class="power-title" data-action="editEntry" data-item-id="{{id}}">{{name}}</button>{{else}}{{name}}{{/if}}</h3>{{#if available}}{{#if @root.editable}}<button type="button" data-action="createGrantedJutsu" data-item-id="{{id}}" aria-label="Adicionar técnica concedida por {{name}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}{{/if}}</header><div class="power-summary"><span>Concedido por aptidão</span></div><header class="jutsu-columns"><span>Jutsus vinculados</span><span>Chakra</span><span>Alcance</span><span></span></header>{{#each techniques}}{{> jutsuRow}}{{else}}<p class="empty-power">Nenhum jutsu adicionado.</p>{{/each}}</section>{{/each}}</section>{{/if}}{{#if editable}}<button type="button" class="add-power" data-action="configurePower"><i class="fa-solid fa-plus"></i> Adicionar poder</button>{{/if}}
{{else}}<header class="pf-section"><h2>{{#if techniques}}Técnicas avulsas{{else}}Efeitos aplicados{{/if}}</h2><div class="controls">{{#if editable}}<button type="button" data-action="createEntry" data-category="{{jutsuTab}}">+ ADICIONAR</button>{{/if}}<button type="button" data-action="browseEntries" data-category="{{jutsuTab}}">BUSCAR</button></div></header><header class="jutsu-columns"><span>{{#if techniques}}Jutsu{{else}}Efeito{{/if}}</span><span>Chakra</span><span>Alcance</span><span></span></header>{{#if techniques}}{{#each looseTechniques}}{{> jutsuRow}}{{else}}<p>Nenhuma técnica avulsa.</p>{{/each}}{{else}}{{#each jutsuEntries}}{{> jutsuRow}}{{/each}}{{/if}}{{/if}}</section>
