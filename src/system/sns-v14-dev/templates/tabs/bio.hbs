<section class="tab-pane bio-pane" role="tabpanel" aria-label="Bio" {{#unless (snsIsTab activeTab "bio")}}hidden{{/unless}}>
  {{#each biography}}<section class="biography-section" aria-label="{{label}}"><h2 class="section-heading">{{label}}</h2><prose-mirror aria-label="{{label}}" name="system.biography.{{key}}" value="{{editorValue}}" toggled {{#unless ../editable}}disabled{{/unless}}>{{{html}}}</prose-mirror></section>{{/each}}
</section>
