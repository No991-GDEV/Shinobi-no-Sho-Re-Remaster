<section class="tab-pane pf-actions" role="tabpanel" aria-label="Ações" {{#unless (snsIsTab activeTab "actions")}}hidden{{/unless}}>
<nav class="sub-nav" aria-label="Tipos de atividade">
<button type="button" data-action="chooseContext" data-group="actions" data-context="encounter" class="{{#if encounter}}active{{/if}}">Encontro</button>
<button type="button" data-action="chooseContext" data-group="actions" data-context="exploration" class="{{#if exploration}}active{{/if}}">Exploração</button>
<button type="button" data-action="chooseContext" data-group="actions" data-context="downtime" class="{{#if downtime}}active{{/if}}">Interlúdio</button></nav>
{{#if encounter}}
<header class="pf-section"><h2>Ataques</h2></header>
<ol class="strike-list">{{#each weaponEntries}}<li class="strike-row"><div class="strike-icon"><img src="{{img}}" alt=""></div><div class="strike-body"><h3 class="strike-name"><button type="button" data-action="editEntry" data-item-id="{{id}}">{{name}}</button></h3><div class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</div><div class="strike-buttons">{{#each weaponChecks}}<button type="button" data-action="rollTest" data-roll="{{key}}" data-item-id="{{../id}}" {{#unless available}}disabled{{/unless}}{{#unless @root.editable}} disabled{{/unless}}>{{label}} {{display}}{{#if origin}} · {{origin}}{{/if}}</button><button type="button" data-action="sheetDamage" data-roll="{{key}}" data-item-id="{{../id}}" data-grade="1" aria-label="Dano {{label}} de {{../name}}" {{#unless available}}disabled{{/unless}}>DANO{{#if hasDamage}} {{damageBase}}{{/if}}</button><button type="button" data-action="sheetDamage" data-roll="{{key}}" data-item-id="{{../id}}" data-grade="4" aria-label="Crítico {{label}} de {{../name}}" {{#unless available}}disabled{{/unless}}>CRÍTICO</button>{{else}}<button type="button" data-action="editEntry" data-item-id="{{id}}">Definir formas de ataque</button>{{/each}}{{#unless temporaryFists}}{{#if details.damage}}<span class="damage-record">Dano da arma {{details.damage}}</span>{{/if}}{{/unless}}</div>{{#unless temporaryFists}}{{#if @root.editable}}<button type="button" class="weapon-usage" data-action="toggleEquipped" data-item-id="{{id}}">{{#if equipped}}EM USO · GUARDAR{{else}}MARCAR EM USO{{/if}}</button>{{/if}}{{/unless}}</div></li>{{/each}}{{#each combat}}{{#unless fixed}}{{#unless (snsIsTab key "lm")}}
<li class="strike-row"><div class="strike-icon"><i class="fa-solid {{#if (snsIsTab key 'cc')}}fa-hand-fist{{else}}fa-bullseye{{/if}}" aria-hidden="true"></i></div><div class="strike-body"><h3 class="strike-name">{{label}}</h3><div class="strike-buttons"><button type="button" data-action="rollTest" data-roll="{{key}}">TESTE {{signedPrecision}}</button></div></div></li>
{{/unless}}{{/unless}}{{/each}}</ol>
<header class="pf-section"><h2>Técnicas / Jutsus</h2></header><ol class="compact-list">{{#each techniqueEntries}}<li class="entry-line jutsu-action-row"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt="">{{name}}</button><span class="jutsu-action-meta">{{#if blockedReason}}{{blockedReason}}{{else}}{{details.action}} · Chakra {{details.chakraCost}} · {{details.range}} · DB {{details.damage}}{{/if}}</span>{{#if canUse}}{{#if @root.editable}}<button type="button" data-action="useJutsu" data-item-id="{{id}}" aria-label="Usar {{name}}"><i class="fa-solid fa-dice" aria-hidden="true"></i> Usar</button>{{/if}}{{/if}}</li>{{else}}<li class="empty-state">Cadastre técnicas na aba Jutsus.</li>{{/each}}</ol>
{{#each actionGroups}}<header class="pf-section"><h2>{{label}}</h2><div class="controls">
{{#if ../editable}}<button type="button" data-action="createEntry" data-category="{{id}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> CRIAR AÇÃO</button>{{/if}}<button type="button" data-action="browseEntries" data-category="{{id}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> BUSCAR</button></div></header>
<ol class="compact-list">{{#each entries}}<li class="entry-line"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt=""> {{name}}</button>{{#if @root.editable}}<button type="button" class="inline-control" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}<div class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</div></li>{{/each}}
{{#if (snsIsTab id "reaction")}}<li class="strike-row"><div class="strike-icon"><i class="fa-solid fa-shield" aria-hidden="true"></i></div><div class="strike-body"><h3 class="strike-name">Esquiva</h3><div class="strike-buttons"><span class="fixed">REAÇÃO FIXA {{../d.fixedDodge}}</span></div></div></li>{{/if}}</ol>
{{/each}}
{{> "systems/sns-v14-dev/templates/partials/transformations.hbs"}}
{{> "systems/sns-v14-dev/templates/partials/active-aptitudes.hbs"}}
{{else}}<header class="pf-section"><h2>Ações</h2><div class="controls">{{#if editable}}<button type="button" data-action="createEntry" data-category="{{actionTab}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> CRIAR AÇÃO</button>{{/if}}<button type="button" data-action="browseEntries" data-category="{{actionTab}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> BUSCAR</button></div></header>
<ol class="compact-list">{{#if exploration}}{{#each explorationEntries}}<li class="entry-line"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt=""> {{name}}</button>{{#if @root.editable}}<button type="button" class="inline-control" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}<div class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</div></li>{{/each}}{{/if}}{{#if downtime}}{{#each downtimeEntries}}<li class="entry-line"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt=""> {{name}}</button>{{#if @root.editable}}<button type="button" class="inline-control" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}<div class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</div></li>{{/each}}{{/if}}</ol>{{/if}}
</section>
