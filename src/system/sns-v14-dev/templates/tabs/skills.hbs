<section class="tab-pane" role="tabpanel" aria-label="Perícias" {{#unless (snsIsTab activeTab "skills")}}hidden{{/unless}}>
<header class="pf-section"><h2>Perícias gerais</h2>{{> "systems/sns-v14-dev/templates/partials/budget-context.hbs" budget=d.budgets.skills label="Pontos de perícia"}}</header><ul class="pf-skills">
{{#each generalSkills}}<li class="pf-skill {{#unless available}}unavailable{{/unless}}"><button type="button" class="skill-roll" data-action="rollTest" data-roll="skill:{{key}}" {{#unless available}}disabled{{/unless}} aria-label="Testar {{name}}" title="Nível {{level}} · {{modifier.origin}} {{modifier.value}}"><img class="die-icon" src="{{@root.basePath}}/assets/d8-outline.svg" alt="" aria-hidden="true"><span>{{signedPrecision}}</span></button><span class="skill-name">{{name}}</span><button type="button" class="skill-rank rank-{{badgeColor}}" title="{{#if trained}}Treinada{{else}}Não treinada{{/if}} · precisão {{signedPrecision}}" data-action="editSkill" data-skill="{{key}}" aria-label="Editar {{name}}" {{#unless ../editable}}disabled{{/unless}}>{{#if trained}}TREINADA{{else}}NÃO TREINADA{{/if}}</button></li>{{/each}}</ul>
<header class="pf-section"><h2>Perícias especiais</h2></header><ul class="pf-skills">{{#each specialSkills}}<li class="pf-skill full {{#unless available}}unavailable{{/unless}}"><button type="button" class="skill-roll" data-action="rollTest" data-roll="skill:{{key}}" {{#unless available}}disabled{{/unless}} aria-label="Testar {{name}}"><img class="die-icon" src="{{@root.basePath}}/assets/d8-outline.svg" alt="" aria-hidden="true">{{signedPrecision}}</button><span class="skill-name">{{name}}</span><button type="button" class="skill-rank rank-{{badgeColor}}" title="{{#if trained}}Treinada{{else}}Não treinada{{/if}} · precisão {{signedPrecision}}" data-action="editSkill" data-skill="{{key}}" aria-label="Editar {{name}}" {{#unless ../editable}}disabled{{/unless}}>{{#if trained}}TREINADA{{else}}NÃO TREINADA{{/if}}</button></li>{{/each}}</ul>
<header class="pf-section"><h2>Ataques</h2></header><ul class="pf-skills">{{#each combat}}{{#unless fixed}}{{#unless (snsIsTab key "lm")}}<li class="pf-skill"><button type="button" class="skill-roll" data-action="rollTest" data-roll="{{key}}"><img class="die-icon" src="{{@root.basePath}}/assets/d8-outline.svg" alt="" aria-hidden="true">{{signedPrecision}}</button><span class="skill-name">{{label}}</span></li>{{/unless}}{{/unless}}{{/each}}</ul>
<header class="pf-section"><h2>Defesas</h2></header><ul class="pf-skills"><li class="pf-skill"><strong>{{d.fixedDodge}}</strong><span class="skill-name">Reação de esquiva</span></li><li class="pf-skill"><button type="button" class="skill-roll" data-action="rollTest" data-roll="lm"><img class="die-icon" src="{{@root.basePath}}/assets/d8-outline.svg" alt="" aria-hidden="true">{{d.combat.lm.precision}}</button><span class="skill-name">Ler movimento</span></li></ul>
{{#if isGM}}<details><summary>Acessos especiais</summary><fieldset class="access"><label><input type="checkbox" name="system.access.quimico" data-dtype="Boolean" {{#if source.access.quimico}}checked{{/if}}> Químico: Venefício</label><label><input type="checkbox" name="system.access.voo" data-dtype="Boolean" {{#if source.access.voo}}checked{{/if}}> Voo concedido por regra específica</label></fieldset></details>{{/if}}</section>
