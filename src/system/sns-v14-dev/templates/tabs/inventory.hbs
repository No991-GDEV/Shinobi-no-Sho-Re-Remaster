<section class="tab-pane inventory-pane" role="tabpanel" aria-label="Inventário" {{#unless (snsIsTab activeTab "inventory")}}hidden{{/unless}}>
<div class="inventory-currency"><span>Moeda</span><span class="ryo"><i class="fa-solid fa-coins" aria-hidden="true"></i> {{ryo}} Ryo</span>{{#if isGM}}<button type="button" class="inline-control" data-action="editMoney" aria-label="Editar saldo Ryo"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}</div>
<div class="currency-note"><span><i class="fa-solid fa-coins" aria-hidden="true"></i> Saldo total {{ryo}} Ryo</span></div>
<div class="inventory-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" aria-label="Pesquisar inventário" placeholder="Pesquisar inventário"></div>
{{#each inventoryGroups}}<header class="inventory-header"><h3>{{label}}</h3><span>QTD.</span><span>COMP.</span><div class="controls">{{#if ../editable}}<button type="button" data-action="createEntry" data-category="{{id}}" aria-label="Adicionar em {{label}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}<button type="button" data-action="browseEntries" data-category="{{id}}" aria-label="Buscar {{label}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button></div></header>
<div>{{#each entries}}<div class="inventory-row" data-entry-name="{{name}}" data-tags="{{tagsText}}"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt=""><span>{{name}}<span class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</span></span></button><div class="quantity">{{#if ../../editable}}<button type="button" data-action="changeQuantity" data-item-id="{{id}}" data-delta="-1" aria-label="Diminuir {{name}}">−</button>{{/if}}<span>{{quantity}}</span>{{#if ../../editable}}<button type="button" data-action="changeQuantity" data-item-id="{{id}}" data-delta="1" aria-label="Aumentar {{name}}">+</button>{{/if}}</div><span class="comp">{{compartments}}</span><div class="entry-controls">{{#if ../../editable}}<button type="button" data-action="toggleEquipped" data-item-id="{{id}}" class="{{#if equipped}}equipped{{/if}}" aria-label="Alternar uso de {{name}}"><i class="fa-solid fa-shirt"></i></button><button type="button" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}<button type="button" data-action="editEntry" data-item-id="{{id}}" aria-label="Editar {{name}}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button></div></div>{{/each}}</div>{{/each}}
<footer class="inventory-foot"><span>Compartimentos ocupados: {{load}}</span><span>Limite básico sem penalidade: 3</span></footer></section>
