<section class="tab-pane crafting-pane" role="tabpanel" aria-label="Produção" {{#unless (snsIsTab activeTab "crafting")}}hidden{{/unless}}>
<header class="pf-section"><h2>Fórmulas conhecidas</h2><div class="controls">{{#if editable}}<button type="button" data-action="createEntry" data-category="formula"><i class="fa-solid fa-plus" aria-hidden="true"></i> ADICIONAR</button>{{/if}}<button type="button" data-action="browseEntries" data-category="formula"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> BUSCAR</button></div></header>
{{#unless formulas}}<p class="crafting-empty">Nenhuma fórmula conhecida.</p>{{/unless}}
<ol class="formula-list">{{#each formulas}}<li class="formula-row"><button type="button" class="entry-name" data-action="editEntry" data-item-id="{{id}}" aria-label="Consultar fórmula {{name}}"><img src="{{img}}" alt=""><span>{{name}}<span class="entry-tags">{{#each tags}}<span class="sns-tag">{{this}}</span>{{/each}}</span></span></button><div class="entry-controls"><button type="button" data-action="craftEntry" data-item-id="{{id}}" aria-label="Preparar {{name}}"><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{#if @root.editable}}Fabricar{{else}}Ver preparo{{/if}}</button>{{#if @root.editable}}<button type="button" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</div></li>{{/each}}</ol></section>
