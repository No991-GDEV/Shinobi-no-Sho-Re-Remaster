<div class="evolution-content">
  <header class="evolution-heading"><strong>{{actor.name}}</strong><span>NC atual {{currentNc}}</span></header>
  <div class="evolution-level"><label>Nível de campanha<select name="nc" {{#unless editable}}disabled{{/unless}}>{{#each ncChoices}}<option value="{{nc}}" {{#if selected}}selected{{/if}}>NC {{nc}}</option>{{/each}}</select></label>{{#if editable}}{{#if nextAvailable}}<button type="button" data-action="nextNc">Próximo NC</button>{{/if}}{{/if}}</div>
  <p class="evolution-note">Os pontos seguem a tabela de NC; os gastos vêm das aquisições.</p>
  {{#if proposal}}<div class="sns-evolution-proposal"><strong>{{#if lowering}}Redução do orçamento{{else}}Mudança ao aplicar{{/if}}</strong>{{#each proposal}}<span>{{label}} {{signed}} · total {{after}}</span>{{/each}}</div>{{/if}}
  {{#if pointError}}<p class="validation-notes">{{pointError}}</p>{{/if}}{{#if lowering}}<p class="validation-notes">Redistribua os pontos excedentes no assistente.</p>{{/if}}<div class="evolution-section"><h2>Pontos de evolução</h2>{{#if canInitialPoints}}<button type="button" data-action="initialPoints">Definir pontos iniciais</button>{{/if}}{{#if isGM}}{{#if editable}}<button type="button" data-action="grant">+ Conceder</button>{{/if}}{{/if}}</div>
  <table class="evolution-points"><thead><tr><th>Categoria</th><th>Concedidos</th><th>Gastos</th><th>Saldo</th></tr></thead><tbody>{{#each budgets}}<tr><td>{{label}}</td><td>{{granted}}</td><td>{{spent}}</td><td>{{balance}}</td></tr>{{/each}}</tbody></table>
  <div class="evolution-options">{{#if isGM}}<label>Fase da ficha<select name="phase" {{#unless editable}}disabled{{/unless}}><option value="creation" {{#if creation}}selected{{/if}}>Criação</option><option value="evolution" {{#unless creation}}selected{{/unless}}>Evolução</option></select></label>{{else}}<span>{{phaseLabel}}</span>{{/if}}<span>Aptidões gratuitas <strong>{{investment.freeUsed}} / {{investment.freeLimit}}</strong></span></div>
  <section class="sns-investment-list"><h3>Aquisições · {{investment.computedSpent}} PP</h3><p>Poderes: {{investment.powerSpent}} PP · Aptidões adicionais: {{investment.aptitudeSpent}} PP</p>{{#each investmentRows}}<div class="sns-investment-row"><span>{{name}}</span>{{#if canChoose}}{{#if @root.editable}}<button type="button" data-action="acquisition" data-item-id="{{id}}">{{costLabel}}</button>{{else}}<strong>{{costLabel}}</strong>{{/if}}{{else}}<strong>{{costLabel}}</strong>{{/if}}</div>{{else}}<p>Nenhuma aquisição.</p>{{/each}}</section>
  {{#if investment.legacySpent}}<p class="evolution-note">Contador anterior: {{investment.legacySpent}} PP.{{#if investment.legacyPending}} Revisão pelo mestre pendente.{{#if isGM}} <button type="button" data-action="reviewLegacy">Revisar PP anteriores</button>{{/if}}{{/if}}</p>{{/if}}
  {{#if issues}}<details class="evolution-review"><summary>Conferir evolução · {{issueCount}}</summary><ul>{{#each issues}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
  {{#if grants}}<details class="evolution-history"><summary>Orçamento e concessões atuais</summary><ul>{{#each grants}}<li>{{label}} {{signed}} · total {{after}} · {{note}}</li>{{/each}}</ul></details>{{/if}}
  {{#if ncHistory}}<details class="evolution-history"><summary>Alterações de NC</summary><ul>{{#each ncHistory}}<li>NC {{from}} → NC {{to}}</li>{{/each}}</ul></details>{{/if}}{{#if editable}}<button type="submit" class="evolution-save">Salvar evolução</button>{{/if}}
</div>
