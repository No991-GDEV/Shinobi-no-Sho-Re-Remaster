<ol class="plain sns-parties" aria-label="Equipes">
  {{#if activeParty}}
    {{> partyEntry party=activeParty}}
  {{/if}}
  {{#if otherParties.length}}
    {{#if multipleOthers}}
      <li class="directory-item folder other-parties flexcol {{#if otherPartiesExpanded}}expanded{{/if}}" data-entry-id="otherParties">
        <header class="folder-header party-folder" data-action="togglePartyFolder">
          <i class="fa-solid fa-folder-open fa-fw" inert></i>
          <span class="folder-name ellipsis">Outras equipes</span>
          {{#if @root.isGM}}
            <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createParty" data-tooltip="Criar equipe" aria-label="Criar equipe"></button>
          {{/if}}
        </header>
        <ol class="subdirectory plain">
          {{#each otherParties as |party|}}
            {{> partyEntry party=party}}
          {{/each}}
        </ol>
      </li>
    {{else}}
      {{#each otherParties as |party|}}
        {{> partyEntry party=party}}
      {{/each}}
    {{/if}}
  {{/if}}
  {{#if showCreateButton}}
    <li class="sns-party-create-row">
      <button type="button" class="party-create" data-action="createParty"><i class="fa-solid fa-plus" aria-hidden="true"></i> Criar equipe</button>
    </li>
  {{/if}}
</ol>

{{#*inline "partyEntry"}}
  <li class="directory-item folder flexcol {{#if party.expanded}}expanded{{/if}}" data-party data-entry-id="{{party.id}}">
    <header class="folder-header {{#if party.active}}active{{/if}}" data-action="togglePartyFolder">
      <i class="fa-solid fa-folder-open fa-fw" inert></i>
      <button type="button" class="inline-control icon fa-solid fa-file-lines" data-action="openPartySheet" data-tooltip="Abrir ficha da equipe" aria-label="Abrir ficha de {{party.name}}"></button>
      <img src="{{party.img}}" hidden alt="">
      <span class="folder-name ellipsis">{{party.name}}</span>
      {{#if @root.isGM}}
        {{#unless party.active}}
          <button type="button" class="inline-control icon fa-regular fa-star" data-action="activateParty" data-tooltip="Definir como equipe ativa" aria-label="Definir {{party.name}} como equipe ativa"></button>
        {{/unless}}
        <button type="button" class="inline-control icon fa-solid fa-user-plus" data-action="addPartyMember" data-tooltip="Vincular personagem existente" aria-label="Vincular integrante a {{party.name}}"></button>
        <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createPartyMember" data-tooltip="Criar personagem na equipe" aria-label="Criar personagem em {{party.name}}"></button>
      {{/if}}
    </header>
    <ol class="subdirectory plain">
      {{#each party.members}}
        {{> (lookup @root "entryPartial")}}
      {{else}}
        <li class="blank party-empty" data-entry-id="">Nenhum integrante visível.{{#if @root.isGM}} Arraste fichas para esta equipe.{{/if}}</li>
      {{/each}}
    </ol>
  </li>
{{/inline}}
