<section class="applied-states sns-effects-panel" aria-label="Estados temporários ativos">
<header class="sns-effects-heading"><h2>Efeitos ativos <span class="sns-effects-count">{{temporaryEffects.length}}</span></h2><div>{{#if isGM}}<button type="button" data-action="applyCondition"><i class="fa-solid fa-plus"></i> Condição</button><button type="button" data-action="endActorScene">Encerrar cena</button>{{/if}}</div></header>
{{#each temporaryEffects}}<article class="applied-state sns-effect-card {{#if illusionRoot}}is-illusion{{/if}} {{#unless valid}}has-warning{{/unless}}" data-activation-id="{{id}}">
 <img class="sns-effect-icon" src="{{img}}" alt="" title="{{typeLabel}}"><div class="sns-effect-content">
 <header>{{#if condition}}<button type="button" data-action="editEntry" data-item-id="{{id}}">{{name}}</button>{{else}}<strong>{{name}}</strong>{{/if}}<span class="sns-effect-duration" title="{{duration}}"><i class="fa-regular fa-clock" aria-hidden="true"></i> {{durationShort}}</span></header>
 {{#if illusionMeta}}<small class="sns-effect-meta">{{illusionMeta}}</small>{{/if}}
 {{#if relatedConditions}}<div class="sns-effect-related">{{#each relatedConditions}}<button type="button" data-action="editEntry" data-item-id="{{id}}"><img src="{{img}}" alt="">{{name}}</button>{{/each}}</div>{{/if}}
 <p class="sns-effect-summary">{{displaySummary}}</p><div class="sns-effect-origin"><i class="fa-solid fa-arrow-turn-up" aria-hidden="true"></i> {{#if hasSource}}<button type="button" data-action="editEntry" data-item-id="{{sourceId}}">{{sourceName}}</button>{{else}}{{sourceName}}{{/if}}</div>
 {{#if illusionRoot}}<div class="sns-illusion-controls">{{#if @root.editable}}{{#if noticeAvailable}}<button type="button" class="is-primary" data-action="illusionAction" data-item-id="{{id}}" data-illusion-action="notice"><i class="fa-solid fa-dice-d8"></i> Notar Genjutsu</button>{{/if}}{{#if kaiAvailable}}<button type="button" class="is-primary" data-action="illusionAction" data-item-id="{{id}}" data-illusion-action="kai">Kai · sem custo</button>{{/if}}{{/if}}{{#if @root.isGM}}{{#if manualIllusionTurn}}<button type="button" data-action="illusionAction" data-item-id="{{id}}" data-illusion-action="turn">Contar turno</button>{{/if}}{{/if}}</div>{{#if noticeLater}}<small class="sns-effect-hint">Notar disponível a partir do segundo turno.</small>{{/if}}{{/if}}
 {{#if @root.editable}}{{#if supportPending}}<button type="button" data-action="sustainSupport" data-item-id="{{id}}">Sustentar · ação parcial</button>{{/if}}{{/if}}
 {{#if observers}}<ul class="sns-phantasm-observers">{{#each observers}}<li><strong>{{name}}</strong><span>{{status}}</span></li>{{/each}}</ul>{{/if}}
 {{#each problems}}<p class="sns-effect-warning">{{this}}</p>{{/each}}
 <details class="sns-effect-details"><summary>Descrição e regras</summary><p>{{description}}</p>{{#if note}}<p>{{note}}</p>{{/if}}<small>{{source}}</small>{{#unless support}}{{#unless illusion}}{{#if condition}}{{#if @root.isGM}}<button type="button" data-action="conditionDuration" data-item-id="{{id}}" aria-label="Configurar duração de {{name}}"><i class="fa-solid fa-clock"></i> Configurar duração</button>{{/if}}{{/if}}{{/unless}}{{/unless}}</details>
 {{#if @root.editable}}<div class="sns-effect-inline-actions">{{#each advancedActions}}<button type="button" data-action="environmentAction" data-environment-root="{{../environmentRootUuid}}" data-environment-command="advancedSave" data-environment-state="{{../advancedStateId}}" data-environment-key="{{key}}">{{label}}</button>{{/each}}{{#each environmentEscapeOptions}}<button type="button" data-action="environmentAction" data-environment-root="{{../environmentRootUuid}}" data-environment-command="escape" data-environment-key="{{key}}">{{label}}</button>{{/each}}{{#if environmentPending}}<button type="button" data-action="environmentAction" data-environment-root="{{environmentRootUuid}}" data-environment-command="sustain">Manter · {{#if environmentConcentration}}ação padrão{{else}}ação parcial{{/if}}</button>{{/if}}</div>{{/if}}
 </div>
 {{#if illusionRoot}}{{#if @root.isGM}}<button type="button" class="sns-effect-end" data-action="illusionAction" data-item-id="{{id}}" data-illusion-action="end" aria-label="Encerrar ilusão {{name}}" title="Encerrar ilusão"><i class="fa-solid fa-xmark"></i></button>{{/if}}{{else}}{{#unless illusion}}{{#if @root.editable}}{{#if temporaryTechnique}}<button type="button" class="sns-effect-end" data-action="transformationTechnique" data-source-id="{{sourceId}}" data-technique="{{technique}}" data-variant="retract" title="{{endLabel}}" aria-label="{{endLabel}} {{name}}"><i class="fa-solid fa-xmark"></i></button>{{else}}{{#if transformation}}<button type="button" class="sns-effect-end" data-action="transformationMode" data-source-id="{{sourceId}}" data-mode="normal" data-buff="{{buff}}" title="{{endLabel}}" aria-label="{{endLabel}} {{name}}"><i class="fa-solid fa-xmark"></i></button>{{else}}{{#if condition}}<button type="button" class="sns-effect-end" data-action="endCondition" data-item-id="{{id}}" title="Encerrar" aria-label="Encerrar {{name}}"><i class="fa-solid fa-xmark"></i></button>{{else}}<button type="button" class="sns-effect-end" data-action="toggleActiveAptitude" data-activation-id="{{id}}" title="{{endLabel}}" aria-label="{{endLabel}} {{name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}{{/if}}{{/if}}{{/if}}{{/unless}}{{/if}}
</article>{{else}}<div class="sns-effects-empty"><i class="fa-solid fa-person-rays" aria-hidden="true"></i><strong>Nenhum efeito ativo</strong><p>Condições, transformações e aptidões ativadas aparecem aqui durante o jogo.</p></div>{{/each}}
</section>
