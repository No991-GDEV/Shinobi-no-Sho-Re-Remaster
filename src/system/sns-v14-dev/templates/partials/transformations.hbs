{{#if transformations.length}}<section class="sns-transformations" aria-label="Modos e Transformações">
<header class="pf-section"><h2>Modos e Transformações</h2></header>
{{#each transformations}}<article data-mode-source="{{sourceId}}">
 <header><strong>{{name}}</strong><span>Nível {{level}}</span><span class="mode-current">{{modeName}}</span></header>
 <div class="mode-options"><label>Caudas<select data-mode-option="tails">{{#each tails}}<option value="{{count}}" {{#if selected}}selected{{/if}}>{{count}} · FOR +{{strength}}</option>{{/each}}</select></label><label>Nível usado<select data-mode-option="level">{{#each levels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><label>Reserva<select data-mode-option="resource"><option value="chakra">Chakra</option><option value="bijuu">Chakra bijuu</option>{{#unless control}}<option value="vitality">Vitalidade · técnicas bijuu</option>{{/unless}}</select></label></div>
 <div class="mode-buttons">{{#each modes}}<button type="button" data-action="transformationMode" data-source-id="{{../sourceId}}" data-mode="{{id}}" class="{{#if selected}}is-selected{{/if}}" {{#if disabled}}disabled{{/if}} title="{{action}}">{{name}}</button>{{/each}}</div>
 <p>{{safe}}{{#if benefits}} · {{benefits}}{{/if}}</p>{{#if problem}}<p class="validation-notes">{{problem}}</p>{{/if}}
 <div class="mode-buffs">{{#each buffs}}<button type="button" data-action="transformationMode" data-source-id="{{../sourceId}}" data-buff="{{id}}" class="{{#if active}}is-selected{{/if}}" {{#if disabled}}disabled{{/if}}>{{name}} · Chakra {{cost}}</button>{{/each}}</div>
 {{#if hasTechniques}}<ul class="mode-techniques">{{#each techniques}}<li><span class="mode-technique-icon" aria-hidden="true"><i class="fa-solid fa-{{icon}}"></i></span><div class="mode-technique-info"><strong>{{name}}</strong><small>{{action}} · {{costText}}</small><small>{{range}}</small></div><div class="mode-technique-controls">{{#if shot}}<select data-technique-variant aria-label="Variação de {{name}}"><option value="normal">Tiro Único</option><option value="burst">Tiro em Rajada</option></select>{{/if}}{{#if bomb}}<select data-technique-variant aria-label="Variação de {{name}}"><option value="normal">Esfera</option><option value="cylinder">Cilindro</option></select>{{/if}}{{#if created}}<button type="button" data-action="transformationTechnique" data-source-id="{{../sourceId}}" data-technique="{{id}}" data-variant="retract">Recolher</button>{{/if}}<button type="button" data-action="transformationTechnique" data-source-id="{{../sourceId}}" data-technique="{{id}}">Usar</button></div></li>{{/each}}</ul>{{/if}}
 {{#if @root.isGM}}<details><summary>Opções do mestre</summary><button type="button" data-action="transformationManualTurn">Início de turno fora de combate</button><button type="button" data-action="configureTransformation" data-source-id="{{sourceId}}">Imagens e Controle Total</button><button type="button" data-action="transformationDomain" data-source-id="{{sourceId}}">Teste de domínio</button><button type="button" data-action="transformationRest" data-source-id="{{sourceId}}">Concluir descanso</button></details>{{/if}}
</article>{{/each}}</section>{{/if}}
