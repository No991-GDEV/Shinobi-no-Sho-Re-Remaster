{{#*inline "summaryBadges"}}{{#each this}}<span class="party-skill-badge rank-{{color}}" title="{{actor}}">{{name}} {{signed}}</span>{{else}}<span class="summary-empty">Nenhum resultado.</span>{{/each}}{{/inline}}
{{#*inline "partyEconomy"}}<div class="party-economy-card"><header><img src="{{img}}" alt=""><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button></header><span><i class="fa-solid fa-coins"></i> {{fundsDisplay}} Ryo</span><span>Valor dos itens {{wealthDisplay}} Ryo</span><footer>Compartimentos {{compartments}}</footer></div>{{/inline}}
{{#*inline "partyMiniCard"}}<article class="party-mini-card"><header><img src="{{img}}" alt=""><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button></header><div class="mini-stats"><span><i class="fa-solid fa-person-walking"></i> {{movementDisplay}} m</span><span><i class="fa-solid fa-shield-halved"></i> {{dodge}}</span></div><div class="party-health"><span class="health-fill" style="width:{{healthPercent}}%"></span><strong><i class="fa-solid fa-heart"></i> {{vitality}} / {{vitalityMax}}</strong></div></article>{{/inline}}
<header class="banner-header party-header">{{> portrait}}<div class="banner-title"><input name="name" value="{{actor.name}}" aria-label="Nome">{{> actorTags}}</div><strong class="banner-type">Equipe</strong>{{#if canDeleteParty}}<button type="button" class="party-sheet-delete" data-action="deleteParty" aria-label="Excluir equipe" title="Excluir equipe"><i class="fa-solid fa-trash"></i></button>{{/if}}</header>{{> actorNav}}
<main class="actor-panels party-body {{#if inventory}}party-split{{/if}} {{#if exploration}}party-split{{/if}}">
{{#if notes}}{{> actorFields}}{{> actorNotes}}
{{else}}{{#if inventory}}<aside class="party-sidebar"><section class="party-total"><h4>Total dos integrantes</h4><span>Saldo <strong>{{partySummary.funds}} Ryo</strong></span><span>Valor dos itens <strong>{{partySummary.wealth}} Ryo</strong></span></section>{{#each members}}{{> partyEconomy}}{{/each}}</aside>{{> inventoryPanel}}
{{else}}{{#if exploration}}<aside class="party-sidebar"><section class="party-total"><h4>Viagem e exploração</h4><span>Integrantes <strong>{{partySummary.count}}</strong></span><span>Menor deslocamento <strong>{{partySummary.speed}} m</strong></span><span>Atividades <strong>{{partySummary.activityCount}}</strong></span></section>{{#each members}}{{> partyMiniCard}}{{/each}}</aside><div class="party-main activity-list">{{#each members}}<article class="activity-slot"><img src="{{img}}" alt=""><div class="activity-description">{{#if activity.name}}<strong>{{activity.name}}</strong><span class="activity-member">{{name}}</span><span class="sns-tag">Exploração</span>{{else}}<strong>Atividade</strong><span class="activity-member">{{name}}</span><small>Nenhuma atividade definida</small>{{/if}}</div>{{#if @root.editable}}{{#unless unavailable}}<button type="button" data-action="setActivity" data-uuid="{{uuid}}" class="activity-add" aria-label="Definir atividade de {{name}}"><i class="fa-solid {{#if activity.name}}fa-pen-to-square{{else}}fa-plus{{/if}}"></i></button>{{#if activity.name}}<button type="button" data-action="clearActivity" data-uuid="{{uuid}}" aria-label="Limpar atividade de {{name}}"><i class="fa-solid fa-times"></i></button>{{/if}}{{/unless}}{{/if}}</article>{{/each}}</div>
{{else}}
<section class="party-summary"><nav class="party-summary-tabs" aria-label="Resumo da equipe"><button type="button" data-action="partySummary" data-summary="languages" class="{{#if summaryLanguages}}active{{/if}}">Idiomas da equipe</button><button type="button" data-action="partySummary" data-summary="skills" class="{{#if summarySkills}}active{{/if}}">Perícias da equipe</button><button type="button" data-action="partySummary" data-summary="knowledge" class="{{#if summaryKnowledge}}active{{/if}}">Conhecimentos</button></nav><div class="summary-badges">{{#if summaryLanguages}}{{#each partySummary.languages}}<span class="party-language">{{name}} ({{count}})</span>{{else}}<span class="summary-empty">Nenhum idioma informado.</span>{{/each}}{{else}}{{#if summarySkills}}{{> summaryBadges partySummary.skills}}{{else}}{{> summaryBadges partySummary.knowledge}}{{/if}}{{/if}}</div></section>
<div class="members-toolbar"><span>{{partySummary.count}} integrantes</span>{{#if editable}}<button type="button" data-action="addMember"><i class="fa-solid fa-plus"></i> VINCULAR</button>{{/if}}</div><div class="party-overview-members">{{#each members}}<article class="party-member member-card"><div class="member-portrait"><img src="{{img}}" alt=""><div class="party-health"><span class="health-fill" style="width:{{healthPercent}}%"></span><strong><i class="fa-solid fa-heart"></i> {{vitality}} / {{vitalityMax}}</strong></div></div><div class="member-data"><header class="member-name"><div><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button><small>NC {{nc}}{{#if blurb}} · {{blurb}}{{/if}}</small></div>{{#if @root.editable}}<button type="button" data-action="removeMember" data-uuid="{{uuid}}" aria-label="Desvincular {{name}}">×</button>{{/if}}</header><div class="party-main-stats"><div class="member-dodge"><small>Esquiva</small><strong>{{dodge}}</strong></div><div class="member-combat">{{#each combat}}<span><small>{{label}}</small><strong>{{value}}</strong></span>{{/each}}</div><div class="member-senses"><small>Sentidos</small><span>{{#if senses}}{{senses}}{{else}}Não informados{{/if}}</span></div></div><div class="member-skill-tags">{{> summaryBadges topSkills}}</div></div></article>{{else}}<p class="empty-state">Vincule os personagens que fazem parte desta equipe.</p>{{/each}}</div>
{{/if}}{{/if}}{{/if}}
</main>
