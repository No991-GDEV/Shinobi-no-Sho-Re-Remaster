{{#*inline "summaryBadges"}}{{#each this}}<span class="party-skill-badge rank-{{color}}" title="{{#if tooltip}}{{tooltip}}{{else}}{{actor}}{{/if}}">{{name}} {{signed}}</span>{{else}}<span class="summary-empty">Nenhum resultado.</span>{{/each}}{{/inline}}
{{#*inline "partyEconomy"}}<div class="party-economy-card" data-party-drop-member="{{uuid}}" title="Arraste um item do depósito aqui para transferir"><header><img src="{{img}}" alt=""><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button></header>{{#unless restricted}}<span><i class="fa-solid fa-coins"></i> {{fundsDisplay}} Ryo</span><span>Valor dos itens {{wealthDisplay}} Ryo</span><footer>Compartimentos {{compartments}}</footer>{{/unless}}</div>{{/inline}}
{{#*inline "partyMiniCard"}}<article class="party-mini-card"><header><img src="{{img}}" alt=""><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button></header>{{#unless restricted}}<div class="mini-stats"><span><i class="fa-solid fa-person-walking"></i> {{movementDisplay}} m</span><span><i class="fa-solid fa-shield-halved"></i> {{dodge}}</span></div><div class="party-health"><span class="health-fill" style="width:{{healthPercent}}%"></span><strong><i class="fa-solid fa-heart"></i> {{vitality}} / {{vitalityMax}}</strong></div><div class="party-chakra"><span class="chakra-fill" style="width:{{chakraPercent}}%"></span><strong><i class="fa-solid fa-circle-dot"></i> {{chakra}} / {{chakraMax}}</strong></div>{{/unless}}</article>{{/inline}}
<header class="banner-header party-header">{{> portrait}}<div class="banner-title"><input name="name" value="{{actor.name}}" aria-label="Nome">{{> actorTags}}</div>{{#if canTogglePartyVisibility}}<button type="button" class="party-visibility-toggle {{#unless showPartyStats}}restricted{{/unless}}" data-action="togglePartyVisibility" title="{{#if showPartyStats}}Visão irrestrita: jogadores veem Visão geral e estatísticas{{else}}Visão restrita: apenas o mestre vê Visão geral{{/if}}"><i class="fa-solid {{#if showPartyStats}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i> <span>{{#if showPartyStats}}Visão irrestrita{{else}}Visão restrita{{/if}}</span></button>{{/if}}<strong class="banner-type">Equipe</strong>{{#if canDeleteParty}}<button type="button" class="party-sheet-delete" data-action="deleteParty" aria-label="Excluir equipe" title="Excluir equipe"><i class="fa-solid fa-trash"></i></button>{{/if}}</header>{{> actorNav}}
<main class="actor-panels party-body {{#if inventory}}party-split{{/if}} {{#if exploration}}party-split{{/if}}">
{{#if notes}}{{> actorFields}}{{> actorNotes}}
{{else}}{{#if inventory}}<aside class="party-sidebar">{{#unless partyRestricted}}<section class="party-total"><h4>Total dos integrantes</h4><span>Saldo <strong>{{partySummary.funds}} Ryo</strong></span><span>Valor dos itens <strong>{{partySummary.wealth}} Ryo</strong></span></section>{{/unless}}{{#each members}}{{> partyEconomy}}{{/each}}</aside>{{> inventoryPanel}}
{{else}}{{#if exploration}}<aside class="party-sidebar"><section class="party-total"><h4>Viagem e exploração</h4><span>Integrantes <strong>{{partySummary.count}}</strong></span><span>Menor deslocamento <strong>{{partySummary.speed}} m</strong></span><span>Por minuto <strong>{{partySummary.travel.perMinute}} m</strong></span><span>Por hora <strong>{{partySummary.travel.kmPerHour}} km/h</strong></span><span>Por dia (8h) <strong>{{partySummary.travel.kmPerDay}} km</strong></span><span>Atividades <strong>{{partySummary.activityCount}}</strong></span></section>{{#each members}}{{> partyMiniCard}}{{/each}}</aside><div class="party-main">{{#if showExplorationToolbar}}<header class="party-exploration-toolbar">{{#if editable}}<button type="button" data-action="clearAllActivities" title="Limpar todas as atividades da equipe"><i class="fa-solid fa-eraser" aria-hidden="true"></i> Limpar atividades</button>{{/if}}{{#if isGM}}<button type="button" data-action="promptPartyCheck" title="Enviar pedido de teste ao grupo no chat"><i class="fa-solid fa-dice-d8" aria-hidden="true"></i> Pedir teste ao grupo</button><button type="button" data-action="restParty" title="Realizar descanso completo de 8 horas em todos os integrantes"><i class="fa-solid fa-bed" aria-hidden="true"></i> Descansar equipe</button>{{/if}}</header>{{/if}}<div class="activity-list">{{#each members}}<article class="activity-slot"><img src="{{img}}" alt=""><div class="activity-description">{{#if activity.name}}<strong>{{activity.name}}</strong><span class="activity-member">{{name}}</span><span class="sns-tag">Exploração</span>{{else}}<strong>Atividade</strong><span class="activity-member">{{name}}</span><small>Nenhuma atividade definida</small>{{/if}}</div>{{#if @root.editable}}{{#unless unavailable}}<button type="button" data-action="setActivity" data-uuid="{{uuid}}" class="activity-add" aria-label="Definir atividade de {{name}}"><i class="fa-solid {{#if activity.name}}fa-pen-to-square{{else}}fa-plus{{/if}}"></i></button>{{#if activity.name}}<button type="button" data-action="clearActivity" data-uuid="{{uuid}}" aria-label="Limpar atividade de {{name}}"><i class="fa-solid fa-times"></i></button>{{/if}}{{/unless}}{{/if}}</article>{{/each}}</div></div>
{{else}}{{#unless partyRestricted}}
<section class="party-summary"><nav class="party-summary-tabs" aria-label="Resumo da equipe"><button type="button" data-action="partySummary" data-summary="languages" class="{{#if summaryLanguages}}active{{/if}}">Idiomas da equipe</button><button type="button" data-action="partySummary" data-summary="skills" class="{{#if summarySkills}}active{{/if}}">Perícias da equipe</button><button type="button" data-action="partySummary" data-summary="knowledge" class="{{#if summaryKnowledge}}active{{/if}}">Conhecimentos</button></nav><div class="summary-badges">{{#if summaryLanguages}}{{#each partySummary.languages}}<span class="party-language" title="{{tooltip}}">{{name}} ({{count}})</span>{{else}}<span class="summary-empty">Nenhum idioma informado.</span>{{/each}}{{else}}{{#if summarySkills}}{{> summaryBadges partySummary.skills}}{{else}}{{> summaryBadges partySummary.knowledge}}{{/if}}{{/if}}</div></section>
<div class="members-toolbar"><span>{{partySummary.count}} integrantes</span>{{#if editable}}<button type="button" data-action="addMember"><i class="fa-solid fa-plus"></i> VINCULAR</button>{{/if}}</div><div class="party-overview-members">{{#each members}}<article class="party-member member-card"><div class="member-portrait"><img src="{{img}}" alt=""><div class="party-health"><span class="health-fill" style="width:{{healthPercent}}%"></span><strong><i class="fa-solid fa-heart"></i> {{vitality}} / {{vitalityMax}}</strong></div><div class="party-chakra"><span class="chakra-fill" style="width:{{chakraPercent}}%"></span><strong><i class="fa-solid fa-circle-dot"></i> {{chakra}} / {{chakraMax}}</strong></div></div><div class="member-data"><header class="member-name"><div><button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button><small>NC {{nc}}{{#if blurb}} · {{blurb}}{{/if}}</small></div>{{#if @root.editable}}<button type="button" data-action="removeMember" data-uuid="{{uuid}}" aria-label="Desvincular {{name}}">×</button>{{/if}}</header><div class="party-main-stats"><div class="member-dodge"><small>Esquiva</small><strong>{{dodge}}</strong></div><div class="member-combat">{{#each combat}}{{#if @root.isGM}}{{#if canRoll}}<button type="button" class="party-combat-roll" data-action="rollMemberCheck" data-uuid="{{../uuid}}" data-roll="{{key}}" title="Clique: rolagem secreta (mestre) · Shift+clique: rolagem pública"><small>{{label}}</small><strong>{{value}}</strong></button>{{else}}<span><small>{{label}}</small><strong>{{value}}</strong></span>{{/if}}{{else}}<span><small>{{label}}</small><strong>{{value}}</strong></span>{{/if}}{{/each}}</div><div class="member-senses"><small>Sentidos</small><span>{{#if senses}}{{senses}}{{else}}Não informados{{/if}}</span></div></div><div class="member-skill-tags">{{#if prontidao}}{{#if @root.isGM}}{{#if canRoll}}<button type="button" class="party-skill-badge rollable rank-{{prontidao.color}}" data-action="rollMemberCheck" data-uuid="{{uuid}}" data-roll="skill:prontidao" title="Clique: rolagem secreta (mestre) · Shift+clique: rolagem pública">{{prontidao.name}} {{prontidao.signed}}</button>{{else}}<span class="party-skill-badge rank-{{prontidao.color}}">{{prontidao.name}} {{prontidao.signed}}</span>{{/if}}{{else}}<span class="party-skill-badge rank-{{prontidao.color}}">{{prontidao.name}} {{prontidao.signed}}</span>{{/if}}{{/if}}{{#each topSkills}}{{#if @root.isGM}}{{#if ../canRoll}}<button type="button" class="party-skill-badge rollable rank-{{color}}" data-action="rollMemberCheck" data-uuid="{{../uuid}}" data-roll="skill:{{key}}" title="Clique: rolagem secreta (mestre) · Shift+clique: rolagem pública">{{name}} {{signed}}</button>{{else}}<span class="party-skill-badge rank-{{color}}">{{name}} {{signed}}</span>{{/if}}{{else}}<span class="party-skill-badge rank-{{color}}">{{name}} {{signed}}</span>{{/if}}{{/each}}{{#unless hasSkills}}<span class="summary-empty">Sem perícias treinadas.</span>{{/unless}}</div></div></article>{{else}}<p class="empty-state">Vincule os personagens que fazem parte desta equipe.</p>{{/each}}</div>
{{/unless}}{{/if}}{{/if}}{{/if}}
</main>
