{{#if companionLink}}<section class="sns-companion-link"><label>Invocador<select data-companion-master aria-label="Invocador da equipe" {{#unless editable}}disabled{{/unless}}>{{#each companionLink.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if companionLink.canBuild}}<button type="button" data-action="buildCompanion"><i class="fa-solid fa-sliders"></i> Construção</button>{{/if}}<small>{{companionLink.species}}{{#if companionLink.limit}} · até NC{{companionLink.limit.maxNc}} · {{companionLink.limit.cost}} chakra para invocar{{/if}}</small>{{#if companionLink.calculated}}<small>PP {{companionLink.spent}} / {{companionLink.pp}} · Gratuitas {{companionLink.freeUsed}} / {{companionLink.freeLimit}}</small>{{/if}}{{#if companionLink.problem}}<p class="craft-warning">{{companionLink.problem}}</p>{{/if}}</section>{{/if}}
