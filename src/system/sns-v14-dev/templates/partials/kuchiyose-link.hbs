{{#if companionLink}}<section class="sns-companion-link"><label>Invocador<select data-companion-master aria-label="Invocador da equipe" {{#unless editable}}disabled{{/unless}}>{{#each companionLink.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if companionLink.hasMaster}}<label>Fonte<select data-companion-origin aria-label="Fonte do Kuchiyose" {{#unless companionLink.canChangeOrigin}}disabled{{/unless}}>{{#each companionLink.originChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}{{#if companionLink.canBuild}}<button type="button" data-action="buildCompanion"><i class="fa-solid fa-sliders"></i> Construção</button>{{/if}}<small>{{companionLink.species}}{{#if companionLink.hasMaster}} · {{companionLink.originLabel}}{{/if}}{{#if companionLink.limit}} · até NC{{companionLink.limit.maxNc}} · {{companionLink.limit.cost}} chakra para invocar{{/if}}</small>{{#if companionLink.calculated}}<small>PP {{companionLink.spent}} / {{companionLink.pp}} · Gratuitas {{companionLink.freeUsed}} / {{companionLink.freeLimit}}</small>{{/if}}{{#if companionLink.problem}}<p class="craft-warning">{{companionLink.problem}}</p>{{/if}}</section>{{/if}}
