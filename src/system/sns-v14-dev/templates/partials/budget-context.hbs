<button type="button" class="sns-budget-context {{#if budget.excess}}needs-adjustment{{/if}}" data-action="showEvolution" aria-label="{{label}}: saldo {{budget.balance}}, {{budget.spent}} gastos de {{budget.granted}}" data-tooltip="Abrir evolução e conferir a distribuição"><span>{{label}}</span><strong>{{#if budget.excess}}Retirar {{budget.excess}}{{else}}Saldo {{budget.balance}}{{/if}}</strong><small>{{budget.spent}} / {{budget.granted}} gastos</small></button>
