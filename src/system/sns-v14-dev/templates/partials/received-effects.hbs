<section class="sns-other-effects">
<header class="sns-effects-heading"><h2>Outros efeitos</h2><div>{{#if editable}}<button type="button" data-action="createEntry" data-category="effects" data-item-type="effect"><i class="fa-solid fa-plus"></i> Adicionar</button>{{/if}}<button type="button" data-action="browseEntries" data-category="effects"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button></div></header>
{{#each appliedEffectEntries}}<article class="sns-effect-card is-custom" data-effect-id="{{id}}"><img class="sns-effect-icon" src="{{img}}" alt=""><div class="sns-effect-content"><header><button type="button" data-action="editEntry" data-item-id="{{id}}">{{name}}</button>{{#if details.duration}}<span class="sns-effect-duration">{{details.duration}}</span>{{/if}}</header>{{#if details.sourceActor}}<small>Origem: {{details.sourceActor}}</small>{{/if}}{{#if details.effect}}<p>{{details.effect}}</p>{{/if}}{{#if details.ending}}<small>Término: {{details.ending}}</small>{{/if}}</div>{{#if @root.editable}}<button type="button" class="sns-effect-end" data-action="removeEntry" data-item-id="{{id}}" aria-label="Remover {{name}}" title="Remover"><i class="fa-solid fa-xmark"></i></button>{{/if}}</article>{{else}}<p class="sns-effects-empty compact">Registre aqui efeitos personalizados recebidos durante o jogo.</p>{{/each}}
</section>
