{{#if skillMode}}
<div class="check-modifiers-content stat-editor-content"><div class="skill-editor-heading"><strong>{{name}}</strong><span class="sns-training rank-{{color}}">{{#if skill.trained}}TREINADA{{else}}NÃO TREINADA{{/if}}</span></div>
<div class="dialog-row header"><span class="mod">Componente</span><span class="type">Origem</span><span class="value">Valor</span><span class="step-controls"></span></div>
<div class="dialog-row"><span class="mod">{{attribute}} (½)</span><span class="type"><span class="tag">ATRIBUTO</span></span><output class="value">{{base}}</output><span class="step-controls"></span></div>
<div class="dialog-row"><label class="mod" for="{{appId}}-bought">Níveis comprados</label><span class="type"><span class="tag">PERÍCIA</span></span><input id="{{appId}}-bought" class="value" name="bought" type="number" min="0" step="1" value="{{draft.bought}}" aria-label="Níveis comprados"><div class="step-controls"><button type="button" data-action="step" data-delta="1" aria-label="Aumentar nível da perícia" {{#unless canUp}}disabled{{/unless}}><i class="fa-solid fa-caret-up"></i></button><button type="button" data-action="step" data-delta="-1" aria-label="Diminuir nível da perícia" {{#unless canDown}}disabled{{/unless}}><i class="fa-solid fa-caret-down"></i></button></div></div>
<div class="dialog-row"><label class="mod">Bônus de precisão</label><span class="type"><span class="tag">AJUSTE</span></span><input class="value" name="bonus" type="number" step="1" value="{{draft.bonus}}" aria-label="Bônus de precisão"><span class="step-controls"></span></div>
<label class="origin-field">Origem do ajuste<input name="origin" value="{{draft.origin}}" aria-label="Origem do ajuste"></label><hr>
<div class="check-formula"><span>Nível / precisão</span><output>{{skill.level}} / {{precision}}</output></div><div class="skill-budget {{#if overspent}}budget-warning{{/if}}"><span>Perícias: {{budget.spent}} / {{budget.granted}} pontos</span><strong>Saldo {{budget.balance}}</strong></div><p class="editor-note">Limite de compra no NC: {{limit}}. As setas alteram um nível comprado por vez. A cor acompanha a precisão.</p>{{#if overLimit}}<p class="budget-warning">O valor atual excede o limite do NC.</p>{{/if}}<footer class="stat-editor-footer"><button type="button" data-action="cancel">Cancelar</button><button type="submit" class="roll-submit">Salvar perícia</button></footer></div>
{{else}}
<div class="attribute-builder"><aside class="builder-sidebar"><img src="{{img}}" alt=""><strong>{{name}}</strong><span>NC {{nc}}</span><div class="budget-block"><h3>Atributos principais</h3><strong>{{budget.spent}} / {{budget.granted}}</strong><span>Saldo {{budget.balance}}</span></div><div class="budget-block social"><h3>Carisma e Manipulação</h3><strong>{{socialBudget.spent}} / {{socialBudget.granted}}</strong><span>Saldo {{socialBudget.balance}}</span></div></aside><div class="builder-main"><header class="builder-columns">{{#each attributes}}<span class="{{#if social}}social{{/if}}" title="{{label}}">{{abbr}}</span>{{/each}}</header><div class="builder-values">{{#each attributes}}<div class="attribute-column {{#if social}}social{{/if}}"><button type="button" data-action="step" data-key="{{key}}" data-delta="1" aria-label="Aumentar {{label}}"><i class="fa-solid fa-caret-up"></i></button><input name="{{key}}" type="number" min="0" step="1" value="{{value}}" aria-label="{{label}}"><button type="button" data-action="step" data-key="{{key}}" data-delta="-1" aria-label="Diminuir {{label}}" {{#unless canDown}}disabled{{/unless}}><i class="fa-solid fa-caret-down"></i></button><small>{{label}}</small></div>{{/each}}</div><div class="builder-impact"><span>Vitalidade máxima <strong>{{vitalityMax}}</strong></span><span>Chakra máximo <strong>{{chakraMax}}</strong></span></div><p class="editor-note">Sete atributos principais e dois sociais, com orçamentos separados. Alterar atributos não recupera Vitalidade ou Chakra.</p><footer class="stat-editor-footer"><button type="button" data-action="cancel">Cancelar</button><button type="submit" class="roll-submit">Salvar atributos</button></footer></div></div>
{{/if}}
