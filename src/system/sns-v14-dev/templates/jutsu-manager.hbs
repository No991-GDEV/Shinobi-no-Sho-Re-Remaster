<div class="sns-popup-content">
<h2>{{name}}</h2>{{#if recipeError}}<p role="alert">{{recipeError}}</p>{{/if}}{{#if recipes.length}}<section class="power-recipes"><h3>Técnicas disponíveis</h3>{{#each recipes}}<div><span>{{name}}</span><button type="button" data-action="addRecipe" data-key="{{key}}"><i class="fa-solid fa-plus"></i> Adicionar</button></div>{{/each}}</section>{{/if}}<p>Escolha os jutsus deste poder.</p><label class="jutsu-manager-search"><i class="fa-solid fa-search"></i><input type="search" data-jutsu-search placeholder="Pesquisar jutsus" aria-label="Pesquisar jutsus conhecidos"></label><header class="jutsu-manager-columns"><span>Jutsu</span><span>Ação</span><span>Chakra</span><span>Alcance</span><span>Vínculo</span></header><div class="jutsu-manager-list">{{#each entries}}<article class="jutsu-manager-row" data-jutsu-name="{{name}}"><button type="button" data-action="open" data-id="{{id}}"><img src="{{img}}" alt="">{{name}}</button><span>{{action}}</span><span>{{cost}}</span><span>{{range}}</span>{{#if other}}<small>Outro poder</small>{{else}}{{#if editable}}<button type="button" data-action="link" data-id="{{id}}" class="{{#if linked}}linked{{/if}}" aria-label="{{#if linked}}Desvincular{{else}}Vincular{{/if}} {{name}}">{{#if linked}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-solid fa-plus"></i>{{/if}}</button>{{else}}<span>{{#if linked}}Vinculado{{else}}Avulso{{/if}}</span>{{/if}}{{/if}}</article>{{else}}<p>Nenhum jutsu registrado nesta ficha.</p>{{/each}}</div>

</div>
